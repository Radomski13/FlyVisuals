  <script>
    // ╔══════════════════════════════════════════════════════════════════════╗
    // ║                                                                      ║
    // ║   ✏️  CONFIG — THE ONLY SECTION YOU NEED TO EDIT                     ║
    // ║                                                                      ║
    // ║   Change prices and paste your Stripe Payment Link URLs here.        ║
    // ║   All prices are in whole US dollars.                                ║
    // ║                                                                      ║
    // ╚══════════════════════════════════════════════════════════════════════╝

    const CONFIG = {

      // ── CUSTOM SIGNS ───────────────────────────────────────────────────
      //
      // STRIPE SETUP: Create one Stripe product called "Signs Order" priced
      // at $1.00 per unit. Enable "adjustable quantity" on the Payment Link.
      // Paste that single Payment Link URL into stripeLink below.
      // The store calculates the total and appends ?prefilled_quantity=TOTAL
      // so the customer pays the correct amount in Stripe checkout.
      //
      signs: {
        designFee: 25,   // flat add-on design fee
        minQty:    12,   // minimum order quantity
        qtyStep:   12,   // increment size

        // Volume discount tiers — minQty = minimum to qualify, pct = % off unit price
        volumeDiscounts: [
          { minQty: 12,  pct: 0  },   // base price
          { minQty: 24,  pct: 10 },   // 10% off per unit
          { minQty: 36,  pct: 15 },   // 15% off per unit
          { minQty: 48,  pct: 20 },   // 20% off per unit
          { minQty: 60,  pct: 25 },   // 25% off per unit
        ],

        yardSigns: {
          sizes: [
            { key: '18x24',  label: '18" × 24"',  unitPrice: 8.00 },
            { key: '24x36',  label: '24" × 36"',  unitPrice: 12.00 },
            { key: 'custom', label: 'Custom Size', unitPrice: 14.00, isCustom: true },
          ],
        },

        vinylBanners: {
          sizes: [
            { key: '2x4',    label: "2' × 4'",    unitPrice: 45  },
            { key: '2x6',    label: "2' × 6'",    unitPrice: 65  },
            { key: '3x6',    label: "3' × 6'",    unitPrice: 85  },
            { key: '3x8',    label: "3' × 8'",    unitPrice: 110 },
            { key: '4x8',    label: "4' × 8'",    unitPrice: 130 },
            { key: 'custom', label: 'Custom Size', unitPrice: 150, isCustom: true },
          ],
        },

        // Replace '#' with your Stripe Payment Link for "Signs Order" ($1 unit, adjustable qty)
        stripeLink: '#',
      },

    }; // end CONFIG — ✅ nothing below this line needs to change

    // ══════════════════════════════════════════════════════════════════════
    //  STATE
    // ══════════════════════════════════════════════════════════════════════
    const S = {
      signs: { type: 'yard', size: null, qty: 12, design: false },
    };

    // ══════════════════════════════════════════════════════════════════════
    //  UTILS
    // ══════════════════════════════════════════════════════════════════════
    const $ = id => document.getElementById(id);
    const fmt = n => '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 });

    async function netlifyPost(formName, data) {
      const body = new URLSearchParams({ 'form-name': formName, ...data }).toString();
      await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body,
      });
    }

    function setBtn(id, loading, text) {
      const btn = $(id);
      if (!btn) return;
      btn.disabled = loading;
      btn.textContent = text || btn.dataset.orig || btn.textContent;
      if (!loading && !btn.dataset.orig) btn.dataset.orig = btn.textContent;
    }

    function showErr(id, msg) {
      const el = $(id);
      if (!el) return;
      el.textContent = msg;
      el.style.display = msg ? 'block' : 'none';
    }

    function stripeRedirect(url, totalDollars) {
      if (!url || url === '#') {
        alert('Payment link coming soon — call us at (727) 494-6162 to complete your order.');
        return;
      }
      const final = url.includes('?')
        ? url + '&prefilled_quantity=' + Math.round(totalDollars)
        : url + '?prefilled_quantity=' + Math.round(totalDollars);
      window.location.href = final;
    }

    // ══════════════════════════════════════════════════════════════════════
    //  CUSTOM SIGNS
    // ══════════════════════════════════════════════════════════════════════

    function getSignSizes() {
      return S.signs.type === 'yard'
        ? CONFIG.signs.yardSigns.sizes
        : CONFIG.signs.vinylBanners.sizes;
    }

    function getDiscountPct(qty) {
      const tiers = [...CONFIG.signs.volumeDiscounts].reverse();
      return (tiers.find(t => qty >= t.minQty) || { pct: 0 }).pct;
    }

    function getSignUnitPrice() {
      const size = getSignSizes().find(s => s.key === S.signs.size);
      return size ? size.unitPrice : 0;
    }

    function getSignTotal() {
      const unit  = getSignUnitPrice();
      const disc  = getDiscountPct(S.signs.qty);
      const sub   = unit * (1 - disc / 100) * S.signs.qty;
      const design = S.signs.design ? CONFIG.signs.designFee : 0;
      return Math.round(sub + design);
    }

    function setSignType(type) {
      S.signs.type = type;
      S.signs.size = null;
      document.querySelectorAll('.tt-btn').forEach((b, i) =>
        b.classList.toggle('active', ['yard','banner'][i] === type));
      buildSizeGrid();
      updateSignPanel();
    }

    function buildSizeGrid() {
      const sizes = getSignSizes();
      $('sign-size-grid').innerHTML = sizes.map(s => `
        <div class="size-card ${S.signs.size === s.key ? 'sel' : ''}" onclick="selectSignSize('${s.key}')">
          <span class="sc-lbl">${s.label}</span>
          <span class="sc-price">${fmt(s.unitPrice)} / each</span>
        </div>`).join('');

      const isCustom = S.signs.size && getSignSizes().find(s => s.key === S.signs.size)?.isCustom;
      $('custom-dims').classList.toggle('show', !!isCustom);
    }

    function buildVolTiers() {
      const tiers = CONFIG.signs.volumeDiscounts;
      $('vol-tiers').innerHTML = tiers.map(t => {
        const active = S.signs.qty >= t.minQty &&
          (tiers.indexOf(t) === tiers.length - 1 || S.signs.qty < tiers[tiers.indexOf(t) + 1].minQty);
        const label = t.pct === 0 ? `${t.minQty}+` : `${t.minQty}+ (${t.pct}% off)`;
        return `<div class="vol-badge ${active ? 'active' : ''}">${label}</div>`;
      }).join('');
    }

    function selectSignSize(key) {
      S.signs.size = key;
      buildSizeGrid();
      updateSignPanel();
    }

    function changeQty(dir) {
      const step = CONFIG.signs.qtyStep;
      const min  = CONFIG.signs.minQty;
      S.signs.qty = Math.max(min, S.signs.qty + dir * step);
      $('qty-display').textContent = S.signs.qty;
      buildVolTiers();
      updateSignPanel();
    }

    function toggleDesign() {
      S.signs.design = !S.signs.design;
      $('design-addon').classList.toggle('checked', S.signs.design);
      updateSignPanel();
    }

    function updateSignPanel() {
      const total = getSignTotal();
      const unit  = getSignUnitPrice();
      const disc  = getDiscountPct(S.signs.qty);
      const type  = S.signs.type === 'yard' ? 'Yard Signs' : 'Vinyl Banners';
      const size  = getSignSizes().find(s => s.key === S.signs.size);

      $('sp-type').textContent   = type;
      $('sp-size').textContent   = size ? size.label : '—';
      $('sp-qty').textContent    = S.signs.qty;
      $('sp-unit').textContent   = unit ? `${fmt(unit)} ${disc ? `→ ${fmt(unit * (1 - disc/100))}` : ''}` : '—';
      $('sp-disc').textContent   = disc ? `${disc}% off` : 'None';
      $('sp-design').textContent = S.signs.design ? `Yes (+${fmt(CONFIG.signs.designFee)})` : 'No';
      $('sp-total').innerHTML    = total ? `${fmt(total)}${disc ? `<span class="disc-tag">${disc}% off</span>` : ''}` : '—';

      updateMpb();
    }

    function updateSignTotal() { updateSignPanel(); }

    async function submitSigns() {
      const name  = $('sign-name').value.trim();
      const email = $('sign-email').value.trim();
      const phone = $('sign-phone').value.trim();

      if (!name || !email || !phone) {
        showErr('signs-error', 'Please fill in your name, email, and phone.');
        return;
      }
      if (!S.signs.size) {
        showErr('signs-error', 'Please select a sign size.');
        return;
      }
      showErr('signs-error', '');

      const total  = getSignTotal();
      const type   = S.signs.type === 'yard' ? 'Yard Signs' : 'Vinyl Banners';
      const size   = getSignSizes().find(s => s.key === S.signs.size);
      const link   = CONFIG.signs.stripeLink;

      const btn = $('signs-submit-btn');
      btn.disabled = true;
      btn.textContent = 'Processing...';

      try {
        await netlifyPost('signs-order', {
          name, email, phone,
          'sign-type': type,
          size: size?.label || S.signs.size,
          quantity: S.signs.qty,
          'design-service': S.signs.design ? `Yes (+$${CONFIG.signs.designFee})` : 'No',
          notes: $('sign-notes').value.trim(),
          total: fmt(total),
        });
        btn.textContent = 'Redirecting to payment...';
        setTimeout(() => stripeRedirect(link, total), 400);
      } catch {
        btn.disabled = false;
        btn.textContent = 'Place Order & Pay Securely';
        showErr('signs-error', 'Something went wrong. Please try again or call (727) 494-6162.');
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    //  MOBILE PRICE BAR
    // ══════════════════════════════════════════════════════════════════════
    function updateMpb() {
      const bar = $('mpb');
      const priceEl = $('mpb-price');
      const ctaEl = $('mpb-cta');
      const lblEl = $('mpb-lbl');

      const total = getSignTotal();
      priceEl.textContent = total ? fmt(total) : '—';
      lblEl.textContent = 'Order Total';
      ctaEl.textContent = 'Place Order';
      ctaEl.onclick = submitSigns;
      bar.style.display = 'flex';
    }

    function mobileCta() { $('mpb-cta').onclick?.(); }

    // ══════════════════════════════════════════════════════════════════════
    //  INIT
    // ══════════════════════════════════════════════════════════════════════
    function init() {
      setSignType('yard');
      buildVolTiers();
      updateMpb();
    }

    document.addEventListener('DOMContentLoaded', init);
  
    function toggleMobile() {
      const menu = document.getElementById('mobileMenu');
      const isOpen = menu.classList.toggle('open');
      document.querySelectorAll('.hamburger').forEach(h => h.classList.toggle('open', isOpen));
    }

    function toggleMobAccordion(btn) {
      const body = btn.nextElementSibling;
      const isOpen = body.classList.contains('open');
      document.querySelectorAll('.mob-accordion-body.open').forEach(b => b.classList.remove('open'));
      document.querySelectorAll('.mob-accordion-header.open').forEach(b => b.classList.remove('open'));
      if (!isOpen) {
        body.classList.add('open');
        btn.classList.add('open');
      }
    }

    // Close mobile menu on outside click
    document.addEventListener('click', function(e) {
      const menu = document.getElementById('mobileMenu');
      const hamburgers = document.querySelectorAll('.hamburger');
      const clickedHamburger = Array.from(hamburgers).some(h => h.contains(e.target));
      if (menu.classList.contains('open') && !menu.contains(e.target) && !clickedHamburger) {
        menu.classList.remove('open');
        hamburgers.forEach(h => h.classList.remove('open'));
      }
    });

    // Navbar scroll effect
    window.addEventListener('scroll', function() {
      const navbar = document.getElementById('navbar');
      if (!navbar) return;
      if (window.scrollY > 30) {
        navbar.style.background = 'rgba(10,10,10,0.99)';
      } else {
        navbar.style.background = 'rgba(10,10,10,0.97)';
      }
    });

  </script>
