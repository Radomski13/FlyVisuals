  // City-specific intro paragraphs per service type
  const cityServiceIntros = {
    'vehicle-wraps': (c) => `Your vehicles are already on ${c.roads.split(',')[0].trim()} and the roads your ${c.name} customers know — every mile is either working as advertising or wasting that visibility. A professionally installed wrap from Fly Visuals turns that daily driving into thousands of brand impressions per week at no recurring cost. We design, print, and install in-house at our Port Richey shop using 3M and Avery Dennison cast vinyl.`,
    'car-wraps': (c) => `${c.name} drivers on ${c.roads.split(',')[0].trim()} can tell the difference between a quality car wrap and one that's starting to lift at the edges or purple in the sun. Fly Visuals installs cast vinyl only — never cheap calendered film. The difference shows up in how it conforms on day one and how it looks three years later in Florida's heat and UV.`,
    'truck-wraps': (c) => `A wrapped work truck rolling down ${c.roads.split(',')[0].trim()} in ${c.name} is advertising that runs every single day without a media budget. Fly Visuals wraps pickup trucks, box trucks, and work trucks for ${c.county} contractors and service businesses using 3M and Avery Dennison cast vinyl — designed in-house, installed in Port Richey, built to last.`,
    'van-wraps': (c) => `Service vans running routes through ${c.name} — past ${c.landmarks.split(',')[0].trim()} and the surrounding ${c.county} neighborhoods — are visible to thousands of potential customers on every single run. Fly Visuals wraps Ford Transits, Sprinters, Ram ProMasters, and every other van with full-coverage cast vinyl built to hold up in Florida's heat and UV.`,
    'fleet-wraps': (c) => `Every vehicle your company runs on ${c.roads.split(',')[0].trim()} is either building your brand or losing that opportunity. Fly Visuals handles fleet wrap projects for ${c.name} businesses of any size — in-house design that keeps every vehicle consistent, volume pricing, and staggered installs so your ${c.county} operation keeps running without downtime.`,
    'boat-wraps': (c) => `${c.name} boaters know what Florida's UV, salt air, and relentless sun does to cheap vinyl — it fails fast and looks worse on the way out. Fly Visuals installs marine-grade cast vinyl rated specifically for saltwater and Gulf Coast conditions. The result holds up through multiple seasons, not just months. Our Port Richey shop serves boaters from across ${c.county} and the greater Tampa Bay area.`,
    'wall-wraps': (c) => `A blank wall inside your ${c.name} business — near ${c.landmarks.split(',')[0].trim()} or anywhere along the ${c.roads.split(',')[0].trim()} corridor — is brand space you're not using. A Fly Visuals wall wrap transforms that surface into a full-color statement that works 24 hours a day for retail stores, gyms, offices, and restaurants across ${c.county}.`,
    'trailer-wraps': (c) => `Trailers moving through ${c.name} on ${c.roads.split(',')[0].trim()} are among the largest mobile advertising surfaces on the road — and most of them are blank. Fly Visuals wraps utility trailers, enclosed trailers, and semi trailers with cast vinyl graphics that hold up on Florida highways mile after mile without peeling or fading.`,
    'bus-wraps': (c) => `A fully wrapped bus on ${c.roads.split(',')[0].trim()} in ${c.name} is impossible to ignore. Fly Visuals has the large-format printing capacity and installation experience to cover any size bus — school buses, charter coaches, shuttles, and transit vehicles — with full-coverage graphics built for ${c.county}'s Florida climate and road conditions.`,
    'vehicle-decals-lettering': (c) => `Not every ${c.name} contractor or service business on ${c.roads.split(',')[0].trim()} needs a full wrap. Cut vinyl lettering, printed decals, and partial graphic packages from Fly Visuals deliver clean, professional branding at a budget that makes sense — using the same outdoor-rated vinyl and installation standards we bring to every full wrap job.`,
    'vehicle-window-film': (c) => `Perforated one-way vision window film turns vehicle windows into full-color advertising for ${c.name} businesses without blocking the driver's sightlines. Fly Visuals designs and installs vehicle window graphics for ${c.county} businesses alongside our full wrap and tinting services — one shop, every surface covered.`,
    'magnets': (c) => `${c.name} contractors and service providers who use their personal vehicle for work get a practical solution with Fly Visuals removable magnetic signs — full-color, professionally printed, and off the vehicle the moment the workday ends. Made at our Port Richey shop and ready in days for ${c.county} customers.`,
    'business-wraps': (c) => `${c.name} service businesses and contractors working the ${c.roads.split(',')[0].trim()} corridor know that showing up in a branded vehicle closes jobs before a word is spoken. Fly Visuals designs and installs business vehicle wraps for ${c.county} trades and service companies — from full wrap to partial, concept through install, all in-house.`,
    'signs': (c) => `Custom signs for ${c.name} businesses built to survive Florida's UV, humidity, and storm season near ${c.landmarks.split(',')[0].trim()} and throughout ${c.county}. Fly Visuals produces and installs outdoor signs, channel letters, window lettering, lobby signs, and banners — specced for ${c.county}'s climate, not generic national weather standards.`,
    'indoor-signs': (c) => `The inside of your ${c.name} business — whether it's off ${c.roads.split(',')[0].trim()} or tucked in a ${c.county} office park — tells customers exactly who you are the moment they walk in. Fly Visuals installs lobby signs, dimensional letters, wall graphics, wayfinding systems, and ADA-compliant signage that makes a strong first impression and holds up long-term.`,
    'outdoor-signs': (c) => `${c.name} outdoor signs face direct Florida sun, UV radiation, Gulf Coast humidity, and the occasional tropical storm — cheap materials fail fast here. Fly Visuals specifies aluminum faces, corrosion-resistant hardware, and UV-laminated graphics on every outdoor sign we build for ${c.county} businesses, because we know what the local climate does to anything less.`,
    'business-signs': (c) => `A complete sign package for your ${c.name} business on ${c.roads.split(',')[0].trim()} — storefront sign, window lettering, monument sign, and building graphics done together, done right. Fly Visuals handles design, fabrication, and installation for ${c.county} commercial sign projects of every scale, from a single storefront to a full building package.`,
    'vinyl-banners': (c) => `${c.name} businesses, events, and grand openings need banners that hold up in Florida's outdoor conditions near ${c.landmarks.split(',')[0].trim()} and across ${c.county}. Fly Visuals prints full-color vinyl banners with reinforced hems and rust-proof grommets, UV-resistant inks, and a fast turnaround for tight timelines.`,
    'yard-signs': (c) => `Real estate agents, contractors, and event organizers across ${c.name} and ${c.county} need yard signs that go up fast and hold their color in Florida's sun. Fly Visuals prints full-color corrugated yard signs with a 2–3 day turnaround — single and double-sided, H-stakes and wire stakes included, ready when your job site is.`,
    'auto-tinting': (c) => `Parking near ${c.landmarks.split(',')[0].trim()} or anywhere in ${c.name} means your vehicle heats up fast — Florida's UV load is intense year-round, not just in summer. Fly Visuals installs Madico and LLumar ceramic window tint exclusively: film that blocks infrared heat at the glass, keeps your cabin cool without overloading your AC, and won't purple or bubble in ${c.county}'s climate.`,
    'residential-tinting': (c) => `${c.name} homes in ${c.county} deal with Florida sun beating through the glass year-round — west and south-facing rooms can be brutal by early afternoon. Fly Visuals installs residential solar control window film that cuts heat before it enters the room, reduces glare, protects floors and furniture from UV fade, and lowers your cooling costs without darkening the interior.`,
    'commercial-tinting': (c) => `${c.name} offices and commercial buildings on ${c.roads.split(',')[0].trim()} share the same problem: too much sun through the glass makes the space uncomfortable, drives up the HVAC bill, and creates glare across every screen in the building. Fly Visuals installs commercial window film that solves all three without altering your building's exterior appearance from the street.`,
    'vehicle-graphics': (c) => `Partial graphics and custom artwork let ${c.name} drivers and businesses on ${c.roads.split(',')[0].trim()} brand their vehicles without a full wrap investment. Fly Visuals designs and installs door graphics, hood panels, roof wraps, and custom art sections using the same cast vinyl and installation standards we bring to full wraps — same quality, right-sized scope.`,
    'floor-graphics': (c) => `${c.name} retail stores, restaurants, and event venues near ${c.landmarks.split(',')[0].trim()} use floor graphics to guide customers, reinforce their brand, and make a strong impression right at the entrance. Fly Visuals prints and installs slip-certified full-color floor vinyl built to handle ${c.county} foot traffic and humidity without lifting or fading.`,
    'logo-design': (c) => `Your ${c.name} brand needs to work on the side of a truck on ${c.roads.split(',')[0].trim()}, on a storefront sign, on a banner, and on a business card — all at once. Fly Visuals designs logos built specifically for wrap and sign applications: bold, scalable, print-ready from day one, and yours outright with no monthly fees or licensing.`,
    'window-graphics': (c) => `${c.name} storefronts near ${c.landmarks.split(',')[0].trim()} use window graphics to turn glass into advertising that works around the clock — visible to every driver passing on ${c.roads.split(',')[0].trim()} whether the business is open or closed. Fly Visuals installs one-way vision film, cut vinyl lettering, printed graphics, and frosted privacy film for ${c.county} businesses.`,
    'boat-graphics': (c) => `${c.name} boat owners need registration numbers, hull lettering, and custom graphics installed with vinyl that actually survives Florida's UV and water conditions — not standard wrap film that fails after one season. Fly Visuals uses marine-grade vinyl exclusively for all boat graphics, applied at our Port Richey shop and built to last on ${c.county} waters.`,
    'fleet-graphics': (c) => `Every vehicle in your ${c.name} fleet on ${c.roads.split(',')[0].trim()} is a brand impression — consistent or inconsistent, professional or forgettable. Fly Visuals designs and installs unified fleet graphics for ${c.county} businesses of every size, ensuring color-matched, layout-consistent branding across every truck, van, and car in your fleet. Volume pricing, staggered installs, one shop handling everything.`,
    'acrylic-signs': (c) => `Interior signs for ${c.name} businesses need to make the right impression the moment a client or customer walks through the door. Fly Visuals fabricates premium acrylic lobby signs, dimensional lettering, and office signage for ${c.county} businesses — the kind of sign that communicates quality before anyone says a word.`,
    'aluminum-signs': (c) => `Outdoor signs in ${c.name} face Florida's full force — direct UV, Gulf Coast humidity, and seasonal storms. Fly Visuals builds aluminum sign panels with UV-laminated graphics that hold their color and structure through everything ${c.county}'s climate can throw at them. Built for real outdoor conditions, not trade show weather.`,
    'corrugated-signs': (c) => `When ${c.name} contractors, real estate agents, and event organizers need signs up fast, Fly Visuals delivers corrugated plastic signs in 2–3 days. Full-color, UV-resistant, single or double-sided — with H-stakes and wire stakes included. Ready for job sites, open houses, and events across ${c.county}.`,
  };

