    'logo-design':         { title: 'Logo Design New Port Richey FL | Fly Visuals', description: 'Professional logo design for businesses in New Port Richey & Pasco County, FL. Bold, versatile logos designed for vehicles, signs & print. In-house design team.' },
    'vehicle-decals-lettering': { title: 'Vehicle Decals & Lettering New Port Richey FL | Fly Visuals', description: 'Professional vehicle decals and lettering in New Port Richey, FL. Cut vinyl lettering, printed decals & stickers for cars, trucks, vans & equipment. Serving Pasco County.' },
    'gallery':             { title: 'Wrap & Sign Gallery | Fly Visuals | New Port Richey, FL', description: 'View our portfolio of vehicle wraps, fleet graphics, boat wraps, custom signs & window tinting work by Fly Visuals in New Port Richey, FL.' },
    'contact':             { title: 'Contact Fly Visuals | Free Quote | New Port Richey, FL', description: 'Contact Fly Visuals for a free quote on vehicle wraps, custom signs, or window tinting in New Port Richey, FL. Serving Pasco County. Call (727) 494-6162.' },
    'service-areas':       { title: 'Service Areas | Fly Visuals | Pasco County FL', description: 'Fly Visuals serves New Port Richey, Port Richey, Trinity, Holiday, Wesley Chapel, Zephyrhills, Hudson, Tarpon Springs & all of Pasco County, FL.' }
  };
  // Expose for static site generator (jsdom reads window._flyPageMeta)
  window._flyPageMeta = pageMeta;

  function applyPageMeta(name) {
    const meta = pageMeta[name];
    if (!meta) return;
    document.title = meta.title;
    const descTag = document.querySelector('meta[name="description"]');
    if (descTag) descTag.setAttribute('content', meta.description);
    const canonical = document.querySelector('link[rel="canonical"]');
    if (canonical) {
      // Build nested clean URL (matches static site structure)
      var canonPath = '/';
      if (name && name !== 'home') {
        var cityIds = ['new-port-richey','port-richey','trinity','holiday','odessa','spring-hill',
          'wesley-chapel','land-o-lakes','zephyrhills','hudson-bayonet-point',
          'tarpon-springs','clearwater','st-petersburg','dunedin'];
        var matched = false;
        for (var ci = 0; ci < cityIds.length; ci++) {
          if (name.endsWith('-' + cityIds[ci])) {
            canonPath = '/' + name.slice(0, -(cityIds[ci].length + 1)) + '/' + cityIds[ci] + '/';
            matched = true; break;
          }
        }
        if (!matched) canonPath = '/' + name + '/';
      }
      canonical.setAttribute('href', 'https://flyvisualsfl.com' + canonPath);
    }
    // Inject BreadcrumbList JSON-LD from the page's visual breadcrumb element.
    // CRITICAL: every ListItem must have a valid `item` URL - Google's validator
    // flags "Missing field 'item'" for any middle item without one. We slugify
    // each label to produce a flat URL like /boat-wraps/ matching site structure.
    var oldBc = document.getElementById('__bc_ld');
    if (oldBc) oldBc.remove();
    var currentPage = document.getElementById(name + '-page');
    if (currentPage) {
      var bcEl = currentPage.querySelector('.breadcrumb');
      if (bcEl) {
        var parts = bcEl.textContent.split('/').map(function(s){ return s.trim(); }).filter(Boolean);
        if (parts.length > 1) {
          var _slugify = function(s) {
            return s.toLowerCase()
              .replace(/&/g, '-')
              .replace(/'/g, '')
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/^-+|-+$/g, '');
          };
          var items = parts.map(function(label, i) {
            var item = { '@type': 'ListItem', position: i + 1, name: label };
            if (i === 0) {
              item.item = 'https://flyvisualsfl.com/';
            } else if (i === parts.length - 1) {
              item.item = 'https://flyvisualsfl.com' + canonPath;
            } else {
              item.item = 'https://flyvisualsfl.com/' + _slugify(label) + '/';
            }
            return item;
          });
          var ld = document.createElement('script');
          ld.type = 'application/ld+json';
          ld.id = '__bc_ld';
          ld.textContent = JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':items});
          document.head.appendChild(ld);
        }
      }
    }
    // Inject FAQPage JSON-LD from the page's FAQ accordion
    var oldFaq = document.getElementById('__faq_ld');
    if (oldFaq) oldFaq.remove();
    if (currentPage) {
      var faqItems = currentPage.querySelectorAll('.faq-item');
      if (faqItems.length > 0) {
        var mainEntity = Array.from(faqItems).map(function(item) {
          var q = item.querySelector('.faq-question-text');
          var a = item.querySelector('.faq-answer p');
          if (!q || !a) return null;
          return {
            '@type': 'Question',
            'name': q.textContent.trim(),
            'acceptedAnswer': { '@type': 'Answer', 'text': a.textContent.trim() }
          };
        }).filter(Boolean);
        if (mainEntity.length > 0) {
          var faqLd = document.createElement('script');
          faqLd.type = 'application/ld+json';
          faqLd.id = '__faq_ld';
          faqLd.textContent = JSON.stringify({'@context':'https://schema.org','@type':'FAQPage','mainEntity':mainEntity});
          document.head.appendChild(faqLd);
        }
      }
    }
  }

  var _suppressHashChange = false;

  function showPage(name) {
    // Hide all sections
    document.querySelectorAll('.page-section').forEach(s => s.classList.remove('active'));
    // Show requested
    const target = document.getElementById(name + '-page');
    if (target) {
      target.classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    // Update active nav link
    document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
    // Update title, meta description, and canonical
    applyPageMeta(name);
    // Update URL hash after href="#" default fires (replaceState doesn't trigger hashchange)
    const _hashTarget = name === 'home' ? '/' : '#' + name;
    setTimeout(function() { history.replaceState(null, '', _hashTarget); }, 0);
    return false;
  }

  function toggleReadMore(id, btn) {
    const wrap = document.getElementById(id);
    const isOpen = wrap.classList.toggle('open');
    btn.textContent = isOpen ? 'Read less ↑' : 'Read more ↓';
  }

  function toggleMobile() {
    const menu = document.getElementById('mobileMenu');
    const isOpen = menu.classList.toggle('open');
    document.querySelectorAll('.hamburger').forEach(h => h.classList.toggle('open', isOpen));
  }

  // =====================================================
  // PAGE SLIDESHOWS — add your image URLs here
  // =====================================================
  const slideshowImages = {
    // Format: 'slideshow-id': ['url1.jpg', 'url2.jpg', 'url3.jpg']
    // Add your Netlify image URLs below after uploading photos.
    // Example:
    // 'vehicle-wraps': [
    //   'https://yoursite.netlify.app/images/vehicle-wrap-1.jpg',
    //   'https://yoursite.netlify.app/images/vehicle-wrap-2.jpg',
    // ],
    'vehicle-wraps': ['kia%20sorento%20color%20change%20elemental%20green%20from%20hexis.jpg', 'clean-air-van-fleet-wrap-decals.jpeg', 'andys%20ice%20cream%20fleet%20wrap%20and%20graphic.png'],
    'car-wraps': [],
    'truck-wraps': [],
    'van-wraps': [],
    'trailer-wraps': [],
    'bus-wraps': [],
    'vehicle-decals-lettering': [],
    'window-film': [],
    'magnets': [],
    'fleet-wraps': [],
    'business-wraps': [],
    'boat-wraps': ['yamaha-jet-boat-22sd-wrap.JPG', 'boat%20wrap%20graphics%20tarpon%20springs.jpg'],
    'wall-wraps': [],
    'acrylic-signs': [],
    'aluminum-signs': [],
    'corrugated-signs': [],
    'yard-signs': [],
    'vinyl-banners': [],
    'indoor-signs': [],
    'outdoor-signs': [],
    'business-signs': [],
    'auto-tinting': [],
    'ceramic-tint': [],
    'residential-tinting': [],
    'commercial-tinting': [],
    'vehicle-graphics': [],
    'floor-graphics': [],
    'fleet-graphics': [],
    'logo-design': [],
    'window-graphics': [],
    'boat-graphics': [],
  };

  // Slideshow state
  const ssState = {};

  function ssInit(id) {
    const imgs = slideshowImages[id];
    if (!imgs || imgs.length === 0) return;
    const wrap = document.getElementById('ss-' + id);
    const track = document.getElementById('ss-track-' + id);
    const dotsEl = document.getElementById('ss-dots-' + id);
    if (!wrap || !track) return;

    // Build slides
    track.innerHTML = imgs.map(src => `
      <div class="page-slideshow-slide">
        <img src="${src}" alt="Fly Visuals ${id.replace(/-/g,' ')} photo" loading="lazy">
      </div>`).join('');

    // Build dots
    dotsEl.innerHTML = imgs.map((_, i) =>
      `<button class="page-slideshow-dot${i===0?' active':''}" onclick="ssGo('ss-${id}',${i})"></button>`
    ).join('');

    wrap.setAttribute('data-count', imgs.length);
    ssState[id] = { cur: 0, total: imgs.length };

    // Auto-advance every 5 seconds
    setInterval(() => ssMove('ss-' + id, 1), 5000);
  }

  function ssMove(wrapperId, dir) {
    const id = wrapperId.replace('ss-', '');
    if (!ssState[id]) return;
    const s = ssState[id];
    s.cur = (s.cur + dir + s.total) % s.total;
    ssApply(id);
  }

  function ssGo(wrapperId, idx) {
    const id = wrapperId.replace('ss-', '');
    if (!ssState[id]) return;
    ssState[id].cur = idx;
    ssApply(id);
  }

  function ssApply(id) {
    const s = ssState[id];
    const track = document.getElementById('ss-track-' + id);
    const dots = document.querySelectorAll(`#ss-dots-${id} .page-slideshow-dot`);
    if (track) track.style.transform = `translateX(-${s.cur * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('active', i === s.cur));
  }

  // Init all slideshows on load
  document.addEventListener('DOMContentLoaded', function() {
    Object.keys(slideshowImages).forEach(id => {
      if (window._staticMode) {
        // Static pages already have correct root-absolute <img> markup baked in
        // by the generator. Don't overwrite it — just wire up auto-advance state
        // from the existing DOM so the prev/next buttons and dots still work.
        const wrap = document.getElementById('ss-' + id);
        if (!wrap) return;
        const slideCount = wrap.querySelectorAll('.page-slideshow-slide').length;
        if (slideCount === 0) return;
        ssState[id] = { cur: 0, total: slideCount };
        if (slideCount > 1) setInterval(() => ssMove('ss-' + id, 1), 5000);
      } else {
        ssInit(id);
      }
    });
  });

  function toggleFaq(btn) {
    const answer = btn.nextElementSibling;
    const isOpen = answer.classList.contains('open');
    // Close all within same accordion
    const accordion = btn.closest('.faq-accordion');
    if (accordion) {
      accordion.querySelectorAll('.faq-answer.open').forEach(a => a.classList.remove('open'));
      accordion.querySelectorAll('.faq-question.open').forEach(b => b.classList.remove('open'));
    }
    if (!isOpen) {
      answer.classList.add('open');
      btn.classList.add('open');
      btn.setAttribute('aria-expanded', 'true');
    } else {
      btn.setAttribute('aria-expanded', 'false');
    }
  }

  function toggleFooterCol(h4) {
    if (window.innerWidth > 768) return;
    const ul = h4.nextElementSibling;
    const isOpen = ul.classList.contains('open');
    // Close all
    document.querySelectorAll('.footer-col ul.open').forEach(u => u.classList.remove('open'));
    document.querySelectorAll('.footer-col h4.open').forEach(h => h.classList.remove('open'));
    // Open this one if it was closed
    if (!isOpen) {
      ul.classList.add('open');
      h4.classList.add('open');
    }
  }

  function toggleMobAccordion(btn) {
    const body = btn.nextElementSibling;
    const isOpen = body.classList.contains('open');
    // Close all open accordions
    document.querySelectorAll('.mob-accordion-body.open').forEach(b => b.classList.remove('open'));
    document.querySelectorAll('.mob-accordion-header.open').forEach(b => b.classList.remove('open'));
    // Open this one if it was closed
    if (!isOpen) {
      body.classList.add('open');
      btn.classList.add('open');
    }
  }

  // Close mobile menu on outside click
  document.addEventListener('click', function(e) {
    const menu = document.getElementById('mobileMenu');
    const hamburgers = document.querySelectorAll('.hamburger');
    const clickedHamburger = Array.from(hamburgers).some(h => h.contains(e.target));
    if (menu.classList.contains('open') && !menu.contains(e.target) && !clickedHamburger) {
      menu.classList.remove('open');
      hamburgers.forEach(h => h.classList.remove('open'));
    }
  });

  // Navbar scroll effect
  window.addEventListener('scroll', function() {
    const navbar = document.getElementById('navbar');
    if (window.scrollY > 30) {
      navbar.style.background = 'rgba(10,10,10,0.99)';
    } else {
      navbar.style.background = 'rgba(10,10,10,0.97)';
    }
  });

  // ========== SOCIAL PROOF INJECTION ==========
  // Reviews pool — rotated per page
  const allReviews = [
    { stars:5, text:"Fly Visuals wrapped my work van and it looks absolutely incredible. The design team nailed our brand colors and the install was flawless. I've gotten so many compliments driving around New Port Richey — best investment I've made for my business.", name:"Mike T.", location:"New Port Richey, FL", initial:"M" },
    { stars:5, text:"Had my full fleet of five vans wrapped and couldn't be happier. Professional from start to finish — design, production, and install were all seamless. Our company looks totally different on the roads of Pasco County now. Worth every penny.", name:"Sarah K.", location:"Trinity, FL", initial:"S" },
    { stars:5, text:"Got my windows tinted and outdoor signs done here. Both came out perfect. The team is knowledgeable, pressure-free, and genuinely cares about the result. Best sign and tint shop in the Port Richey area — won't go anywhere else.", name:"Jason R.", location:"Port Richey, FL", initial:"J" },
    { stars:5, text:"Brought my boat in for a full wrap and they delivered beyond what I imagined. Colors are vivid, the install is perfect, and they finished ahead of schedule. Everyone at the marina wants to know who did it. Fly Visuals is the real deal.", name:"Danny V.", location:"Holiday, FL", initial:"D" },
    { stars:5, text:"Had residential window tinting done on my home and the difference is incredible. So much cooler inside and my furniture is protected from fading. The crew was on time, professional, and left everything spotless. Highly recommend!", name:"Linda M.", location:"New Port Richey, FL", initial:"L" },
    { stars:5, text:"The indoor lobby signs they made for our office are stunning — exactly what we envisioned and installed without a hitch. Fast turnaround too. Fly Visuals earned a customer for life. Best sign company in Pasco County, no question.", name:"Amanda C.", location:"Wesley Chapel, FL", initial:"A" },
    { stars:5, text:"Needed a full color change wrap on my personal car and these guys crushed it. Matte black finish with zero imperfections, clean edges everywhere. The whole process from quote to pickup took less than a week. Incredibly impressed.", name:"Carlos M.", location:"Zephyrhills, FL", initial:"C" },
    { stars:5, text:"Got our commercial building windows tinted through Fly Visuals and our energy bills dropped noticeably the very next month. The crew was professional and efficient — they did the entire building in one day. Absolutely worth it.", name:"Teresa B.", location:"Land O Lakes, FL", initial:"T" },
    { stars:5, text:"Had vehicle lettering done on my three work trucks and every single one looks perfectly consistent. Sharp, professional, and done right the first time. These guys know what they're doing. Pasco County's best wrap shop hands down.", name:"Rob W.", location:"Hudson, FL", initial:"R" },
  ];

  const trustItems = [
    { icon:"⭐", label:"5-Star Google Rated", sub:"New Port Richey, FL" },
    { icon:"🏅", label:"3M & Avery Certified", sub:"Premium vinyl films" },
    { icon:"📍", label:"Locally Owned", sub:"Pasco County, FL" },
    { icon:"🛡️", label:"Satisfaction Guarantee", sub:"We stand behind every job" },
    { icon:"⚡", label:"Fast Turnaround", sub:"Most jobs done in days" },
    { icon:"🎨", label:"In-House Design", sub:"From concept to install" },
  ];

  const signTrustItems = [
    { icon:"⭐", label:"5.0 Google Rating", sub:"Verified Google Reviews" },
    { icon:"🖨️", label:"Full-Color Printing", sub:"UV-resistant outdoor inks" },
    { icon:"⚡", label:"Same-Day Available", sub:"Rush orders welcome" },
    { icon:"🎨", label:"In-House Design", sub:"Proof before we print" },
    { icon:"📍", label:"Local Print Shop", sub:"Port Richey, FL" },
    { icon:"📋", label:"Any Quantity", sub:"1 sign to 500+" },
  ];

  function buildTrustBar(items) {
    const list = items || trustItems;
    return `<div class="trust-bar">
      <div class="trust-bar-inner">
        ${list.map(t=>`<div class="trust-item"><div class="trust-icon">${t.icon}</div><div><div class="trust-label">${t.label}</div><div class="trust-sub">${t.sub}</div></div></div>`).join('')}
      </div>
    </div>`;
  }

  let carouselCount = 0;

  function buildReviewsBlock(startIdx, count) {
    const picked = [];
    for(let i=0;i<count;i++) picked.push(allReviews[(startIdx+i) % allReviews.length]);
    const cid = 'svc-carousel-' + (carouselCount++);
    const slides = picked.map(r=>`
      <div class="review-card carousel-slide">
        <div class="review-stars">${'★'.repeat(r.stars)}</div>
        <p class="review-text">${r.text}</p>
        <div class="reviewer">
          <div class="reviewer-avatar">${r.initial}</div>
          <div>
            <div class="reviewer-name">${r.name}</div>
            <div class="reviewer-meta">${r.location}</div>
            <div class="google-verified">✓ Google Review</div>
          </div>
        </div>
      </div>`).join('');

    const html = `<div class="reviews-section">
      <div class="reviews-header">
        <div class="reviews-header-left">
          <div class="section-label">Customer Reviews</div>
          <h2 class="section-title">What Pasco County Customers Say</h2>
        </div>
        <div class="google-badge">
          <div class="google-badge-logo">
            <span class="g-blue">G</span><span class="g-red">o</span><span class="g-yellow">o</span><span class="g-blue">g</span><span class="g-green">l</span><span class="g-red">e</span>
          </div>
          <div class="google-badge-text"><strong>5.0 ★★★★★</strong>&nbsp; Verified Google Reviews · New Port Richey, FL</div>
        </div>
      </div>
      <div class="review-carousel-wrap">
        <button class="carousel-btn carousel-prev" onclick="svcCarousel('${cid}',-1)" aria-label="Previous">&#8592;</button>
        <div class="review-carousel-viewport">
          <div class="review-carousel-track" id="${cid}-track">${slides}</div>
        </div>
        <button class="carousel-btn carousel-next" onclick="svcCarousel('${cid}',1)" aria-label="Next">&#8594;</button>
      </div>
      <div class="carousel-dots" id="${cid}-dots"></div>
    </div>`;

    // Init carousel after insertion on next tick
    setTimeout(() => initSvcCarousel(cid), 0);
    return html;
  }

  const svcCarousels = {};

  function initSvcCarousel(cid) {
    const track = document.getElementById(cid + '-track');
    const dotsWrap = document.getElementById(cid + '-dots');
    if (!track || !dotsWrap) return;

    const state = { current: 0, timer: null };
    svcCarousels[cid] = state;

    function spv() {
      if (window.innerWidth >= 1000) return 3;
      if (window.innerWidth >= 700) return 2;
      return 1;
    }
    const total = track.querySelectorAll('.carousel-slide').length;
    function maxIdx() { return Math.max(0, total - spv()); }

    function buildDots() {
      dotsWrap.innerHTML = '';
      for (let i = 0; i <= maxIdx(); i++) {
        const d = document.createElement('button');
        d.className = 'carousel-dot' + (i === state.current ? ' active' : '');
        d.onclick = () => { resetAuto(); goTo(i); };
        dotsWrap.appendChild(d);
      }
    }

    function goTo(idx) {
      state.current = Math.max(0, Math.min(idx, maxIdx()));
      track.style.transform = `translateX(-${(100 / spv()) * state.current}%)`;
      dotsWrap.querySelectorAll('.carousel-dot').forEach((d,i) => d.classList.toggle('active', i === state.current));
    }

    function resetAuto() {
      clearInterval(state.timer);
      state.timer = setInterval(() => goTo(state.current >= maxIdx() ? 0 : state.current + 1), 5000);
    }

    // Touch support
    let tx = 0;
    track.addEventListener('touchstart', e => { tx = e.touches[0].clientX; }, {passive:true});
    track.addEventListener('touchend', e => {
      const d = tx - e.changedTouches[0].clientX;
      if (Math.abs(d) > 40) { resetAuto(); goTo(state.current + (d > 0 ? 1 : -1)); }
    }, {passive:true});

    window.addEventListener('resize', () => { buildDots(); goTo(Math.min(state.current, maxIdx())); });

    buildDots();
    resetAuto();
  }

  window.svcCarousel = function(cid, dir) {
    const state = svcCarousels[cid];
    if (!state) return;
    clearInterval(state.timer);
    const track = document.getElementById(cid + '-track');
    const dotsWrap = document.getElementById(cid + '-dots');
    function spv() { return window.innerWidth>=1000?3:window.innerWidth>=700?2:1; }
    const total = track.querySelectorAll('.carousel-slide').length;
    const maxIdx = Math.max(0, total - spv());
    state.current = Math.max(0, Math.min(state.current + dir, maxIdx));
    track.style.transform = `translateX(-${(100/spv())*state.current}%)`;
    dotsWrap.querySelectorAll('.carousel-dot').forEach((d,i) => d.classList.toggle('active', i===state.current));
    state.timer = setInterval(() => { window.svcCarousel(cid, 0); const s=svcCarousels[cid]; s.current = s.current >= maxIdx ? 0 : s.current+1; track.style.transform=`translateX(-${(100/spv())*s.current}%)`; dotsWrap.querySelectorAll('.carousel-dot').forEach((d,i)=>d.classList.toggle('active',i===s.current)); }, 5000);
  };

  // Pages that get social proof injected (before their .cta-band)
  const servicePageConfigs = [
    { id:'wraps-page',               reviewStart:0, reviewCount:3 },
    { id:'vehicle-wraps-page',       reviewStart:0, reviewCount:3 },
    { id:'car-wraps-page',           reviewStart:6, reviewCount:2 },
    { id:'truck-wraps-page',         reviewStart:0, reviewCount:2 },
    { id:'van-wraps-page',           reviewStart:1, reviewCount:2 },
    { id:'trailer-wraps-page',       reviewStart:3, reviewCount:2 },
    { id:'bus-wraps-page',           reviewStart:5, reviewCount:2 },
    { id:'vehicle-decals-lettering-page', reviewStart:8, reviewCount:2 },
    { id:'vehicle-window-film-page', reviewStart:2, reviewCount:2 },
    { id:'magnets-page',             reviewStart:6, reviewCount:2 },
    { id:'fleet-wraps-page',         reviewStart:1, reviewCount:3 },
    { id:'boat-wraps-page',          reviewStart:3, reviewCount:2 },
    { id:'wall-wraps-page',          reviewStart:5, reviewCount:2 },
    { id:'signs-page',               reviewStart:2, reviewCount:3, trustType:'signs' },
    { id:'vinyl-banners-page',       reviewStart:5, reviewCount:2, trustType:'signs' },
    { id:'indoor-signs-page',        reviewStart:5, reviewCount:2, trustType:'signs' },
    { id:'outdoor-signs-page',       reviewStart:2, reviewCount:2, trustType:'signs' },
    { id:'business-signs-page',      reviewStart:4, reviewCount:2, trustType:'signs' },
    { id:'tinting-page',             reviewStart:4, reviewCount:3 },
    { id:'auto-tinting-page',        reviewStart:2, reviewCount:3 },
    { id:'residential-tinting-page', reviewStart:4, reviewCount:2 },
    { id:'commercial-tinting-page',  reviewStart:7, reviewCount:2 },
    { id:'business-wraps-page',      reviewStart:2, reviewCount:2 },
    { id:'corrugated-signs-page',    reviewStart:5, reviewCount:2, trustType:'signs' },
    { id:'yard-signs-page',          reviewStart:7, reviewCount:2, trustType:'signs' },
    { id:'acrylic-signs-page',       reviewStart:2, reviewCount:2, trustType:'signs' },
    { id:'aluminum-signs-page',      reviewStart:4, reviewCount:2, trustType:'signs' },
    { id:'vehicle-graphics-page',    reviewStart:1, reviewCount:2 },
    { id:'floor-graphics-page',      reviewStart:3, reviewCount:2 },
    { id:'fleet-graphics-page',      reviewStart:1, reviewCount:2 },
    { id:'logo-design-page',         reviewStart:6, reviewCount:2 },
    { id:'window-graphics-page',     reviewStart:5, reviewCount:2 },
    { id:'boat-graphics-page',       reviewStart:3, reviewCount:2 },
  ];

  document.addEventListener('DOMContentLoaded', function() {
    // In pre-rendered static files all DOM injection already happened at build time
    if (window._staticMode) return;

    servicePageConfigs.forEach(function(cfg) {
      const page = document.getElementById(cfg.id);
      if (!page) return;
      const ctaBand = page.querySelector('.cta-band');
      if (!ctaBand) return;
      const trustBarItems = cfg.trustType === 'signs' ? signTrustItems : undefined;
      ctaBand.insertAdjacentHTML('beforebegin', buildTrustBar(trustBarItems));
      ctaBand.insertAdjacentHTML('beforebegin', buildReviewsBlock(cfg.reviewStart, cfg.reviewCount));
    });

    // Build city pages & inject city grids into service areas sections
    buildCityPages();
    injectCityGrids();

    // Move each FAQ section to just above the service area (or cta-band if no service area)
    document.querySelectorAll('.page-section').forEach(function(page) {
      var faqEl = page.querySelector('.faq-accordion');
      if (!faqEl) return;
      var faqSection = faqEl.closest('.content-block');
      if (!faqSection) return;
      var ref = page.querySelector('.areas-section') || page.querySelector('.cta-band');
      if (ref) ref.parentNode.insertBefore(faqSection, ref);
    });

    // Move CTA button and trust signals into the page hero, below the description text
    document.querySelectorAll('.page-section').forEach(function(page) {
      var heroContent = page.querySelector('.page-hero-content');
      if (!heroContent) return;
      var ctaBtn = page.querySelector('.content-block .content-text .btn-primary');
      if (!ctaBtn) return;
      var trustSignals = ctaBtn.nextElementSibling;
      ctaBtn.style.marginTop = '1.8rem';
      heroContent.appendChild(ctaBtn);
      if (trustSignals && trustSignals.tagName === 'DIV') {
        heroContent.appendChild(trustSignals);
      }
    });

    // Add "Browse Our Portfolio" gallery CTA below the image on every service page
    document.querySelectorAll('.page-section').forEach(function(page) {
      var skip = ['home-page','gallery-page','contact-page','service-areas-page','wraps-page','signs-page','tinting-page','graphics-page'];
      if (skip.indexOf(page.id) !== -1) return;
      var imgCol = page.querySelector('.page-slideshow, .content-img');
      if (!imgCol) return;
      var galleryBtn = document.createElement('a');
      galleryBtn.href = '#';
      galleryBtn.setAttribute('onclick', "return showPage('gallery')");
      galleryBtn.textContent = 'Browse Our Portfolio →';
      galleryBtn.style.cssText = 'display:block;margin-top:1.2rem;text-align:center;background:transparent;border:2px solid var(--red);color:var(--red);padding:0.75rem 1.5rem;font-family:var(--font-display);font-size:1rem;letter-spacing:0.08em;text-decoration:none;transition:background 0.2s,color 0.2s;';
      galleryBtn.addEventListener('mouseenter', function() { this.style.background='var(--red)'; this.style.color='#fff'; });
      galleryBtn.addEventListener('mouseleave', function() { this.style.background='transparent'; this.style.color='var(--red)'; });
      // Wrap image + button in a column div so they stack inside the two-col flex layout
      var wrapper = document.createElement('div');
      wrapper.style.cssText = 'display:flex;flex-direction:column;';
      imgCol.parentNode.insertBefore(wrapper, imgCol);
      wrapper.appendChild(imgCol);
      wrapper.appendChild(galleryBtn);
    });

    // Hash-based routing: show the right page on direct load or back/forward
    function routeFromHash() {
      if (_suppressHashChange) return;
      const hash = window.location.hash.replace('#', '');
      if (hash && document.getElementById(hash + '-page')) {
        showPage(hash);
      }
      // If no hash, leave whatever page is currently showing (don't force home)
    }
    // Initial load: show page from hash if present
    const initHash = window.location.hash.replace('#', '');
    if (initHash && document.getElementById(initHash + '-page')) {
      showPage(initHash);
    }
    window.addEventListener('hashchange', routeFromHash);

    // ========== SIGN PAGE HERO TRUST SIGNALS ==========
    const signHeroTrustHTML = `<div style="display:flex;flex-wrap:wrap;gap:1.2rem;margin-top:1.2rem;align-items:center;">
      <div style="display:flex;align-items:center;gap:0.5rem;font-size:0.78rem;color:var(--grey);">
        <span style="color:var(--red);">✓</span> Rush Orders Welcome
      </div>
      <div style="display:flex;align-items:center;gap:0.5rem;font-size:0.78rem;color:var(--grey);">
        <span style="color:var(--red);">✓</span> In-House Design Included
      </div>
      <div style="display:flex;align-items:center;gap:0.5rem;font-size:0.78rem;color:var(--grey);">
        <span style="color:var(--red);">✓</span> 500+ Signs Printed
      </div>
    </div>`;

    ['signs-page','outdoor-signs-page','indoor-signs-page','business-signs-page',
     'vinyl-banners-page','yard-signs-page','corrugated-signs-page',
     'aluminum-signs-page','acrylic-signs-page'].forEach(function(id) {
      var page = document.getElementById(id);
      if (!page) return;
      var contentText = page.querySelector('.content-block .content-text');
      if (!contentText) return;
      var btn = contentText.querySelector('.btn-primary');
      if (!btn) return;
      btn.insertAdjacentHTML('afterend', signHeroTrustHTML);
    });

    // ========== PRICE MATCH BAND — inject before cta-band on every service page + home ==========
    (function() {
      var pmHTML =
        '<div class="price-match-band">' +
          '<div class="price-match-inner">' +
            '<div class="price-match-icon">🏷️</div>' +
            '<div class="price-match-copy">' +
              '<div class="price-match-eyebrow">Price Match Guarantee</div>' +
              '<div class="price-match-headline">Already have a quote?</div>' +
              '<div class="price-match-sub">We\'ll beat it by 10% — or match it <strong>100% guaranteed.</strong></div>' +
            '</div>' +
            '<a class="btn-primary" href="#" onclick="showPage(\'contact\');return false;" style="flex-shrink:0;white-space:nowrap;">Get Your Quote Matched</a>' +
          '</div>' +
        '</div>';

      var skip = ['gallery-page', 'contact-page'];
      document.querySelectorAll('.page-section').forEach(function(page) {
        if (skip.indexOf(page.id) !== -1) return;
        var ctaBand = page.querySelector('.cta-band');
        if (ctaBand) ctaBand.insertAdjacentHTML('beforebegin', pmHTML);
      });
    })();

  });

  // =====================================================
  // CITY DATA
  // =====================================================
  const cities = [
    {
      id: 'wesley-chapel',
      name: 'Wesley Chapel',
      county: 'Pasco County',
