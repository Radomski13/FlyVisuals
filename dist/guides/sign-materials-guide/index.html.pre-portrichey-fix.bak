/* ── Override showPage for URL navigation ── */
function showPage(name) {
  var url = (typeof _pageUrls !== 'undefined' && _pageUrls[name]) || ('/' + name + '/');
  window.location.href = url;
  return false;
}
window.showPage = showPage;
