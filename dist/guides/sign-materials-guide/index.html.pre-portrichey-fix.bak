  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --black: #f0f0f0;
      --dark: #ffffff;
      --dark2: #e4e4e4;
      --red: #cc1414;
      --red-bright: #e81c1c;
      --red-dark: #8b0000;
      --white: #1a1a1a;
      --grey-light: #333333;
      --grey: #666666;
      --grey-dark: #cccccc;
      --font-display: 'Bebas Neue', sans-serif;
      --font-body: 'Barlow', sans-serif;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--black);
      color: var(--white);
      font-family: var(--font-body);
      font-weight: 300;
      line-height: 1.7;
      overflow-x: hidden;
    }

    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }

    /* ========== NAVBAR ========== */
    #navbar {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 1000;
      background: rgba(10,10,10,0.97);
      border-bottom: 2px solid var(--red);
      padding: 0 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
      backdrop-filter: blur(8px);
    }

    .logo {
      font-family: var(--font-display);
      font-size: 2rem;
      letter-spacing: 0.08em;
      color: var(--white);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .logo span { color: var(--red); }

    nav { display: flex; align-items: center; gap: 0; }

    .nav-item {
      position: relative;
    }

    .nav-link {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.5rem 1rem;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 0.8rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #ffffff;
      cursor: pointer;
      transition: color 0.2s;
      white-space: nowrap;
      border: none;
      background: none;
    }
    .nav-link:hover, .nav-link.active { color: var(--red-bright); }
    .nav-link svg { width: 10px; height: 10px; transition: transform 0.2s; }
    .nav-item:hover .nav-link svg { transform: rotate(180deg); }

    /* Level 1 dropdown */
    .dropdown {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      background: var(--dark2);
      border: 1px solid var(--grey-dark);
      border-top: 2px solid var(--red);
      min-width: 200px;
      z-index: 200;
    }
    .nav-item:hover .dropdown { display: block; }

    .dropdown-item {
      position: relative;
    }
    .dropdown-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1.2rem;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--grey-light);
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      border: none;
      background: none;
      width: 100%;
      text-align: left;
    }
    .dropdown-link:hover { background: var(--red); color: #ffffff; }
    .dropdown-link svg { width: 8px; height: 8px; }

    /* Level 2 dropdown */
    .sub-dropdown {
      display: none;
      position: absolute;
      top: 0;
      left: 100%;
      background: var(--dark);
      border: 1px solid var(--grey-dark);
      border-left: 2px solid var(--red);
      min-width: 210px;
      z-index: 300;
    }
    .dropdown-item:hover .sub-dropdown { display: block; }
    .sub-dropdown a {
      display: block;
      padding: 0.7rem 1.2rem;
      font-size: 0.76rem;
      font-weight: 400;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--grey-light);
      transition: background 0.15s, color 0.15s;
    }
    .sub-dropdown a:hover { background: var(--red-dark); color: #ffffff; }

    /* ========== NAV CALL BUTTON ========== */
    .nav-call-btn {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      margin-left: 0.8rem;
      background: var(--red);
      color: var(--white) !important;
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.55rem 1.1rem;
      border: 2px solid var(--red);
      white-space: nowrap;
      transition: background 0.2s, color 0.2s;
      text-decoration: none;
    }
    .nav-call-btn:hover { background: transparent; color: var(--red) !important; }
    .nav-call-btn svg { flex-shrink: 0; }

    .mob-call-btn {
      display: none;
      align-items: center;
      gap: 0.4rem;
      background: var(--red);
      color: var(--white);
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.45rem 0.85rem;
      border: 2px solid var(--red);
      white-space: nowrap;
      text-decoration: none;
      transition: background 0.2s, color 0.2s;
    }
    .mob-call-btn:hover { background: transparent; color: var(--red); }

    /* Mobile Menu */
    .hamburger {
      display: none;
      flex-direction: column;
      gap: 7px;
      cursor: pointer;
      padding: 12px;
      background: none;
      border: none;
      min-width: 44px;
      min-height: 44px;
      justify-content: center;
      align-items: center;
    }
    .hamburger span {
      display: block;
      width: 34px;
      height: 3px;
      background: #ffffff;
      transition: all 0.3s;
      border-radius: 2px;
    }
    .hamburger.open span:nth-child(1) { transform: translateY(10px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .hamburger.open span:nth-child(3) { transform: translateY(-10px) rotate(-45deg); }

    .mobile-menu {
      display: none;
      position: fixed;
      top: 72px; left: 0; right: 0; bottom: 0;
      background: var(--black);
      overflow-y: auto;
      z-index: 999;
      padding: 1rem 0 3rem;
    }
    .mobile-menu.open { display: block; }

    .mobile-section-header {
      font-family: var(--font-display);
      font-size: 1.1rem;
      letter-spacing: 0.1em;
      color: var(--red);
      padding: 1rem 1.5rem 0.3rem;
      border-top: 1px solid var(--grey-dark);
    }
    .mobile-menu a {
      display: block;
      padding: 0.65rem 1.5rem;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--grey-light);
      border-bottom: 1px solid rgba(255,255,255,0.04);
    }
    .mobile-menu a.sub { padding-left: 2.5rem; font-size: 0.78rem; color: var(--grey); }
    .mobile-menu a:hover { color: #ffffff; background: rgba(204,20,20,0.85); }

    /* Mobile accordion */
    .mob-accordion { border-bottom: 1px solid rgba(255,255,255,0.06); }
    .mob-accordion-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 1rem 1.5rem;
      background: none;
      border: none;
      color: var(--grey-light);
      font-family: var(--font-body);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      cursor: pointer;
      text-align: left;
    }
    .mob-accordion-header:hover { color: #ffffff; background: rgba(204,20,20,0.85); }
    .mob-acc-arrow {
      width: 12px; height: 12px;
      transition: transform 0.25s;
      flex-shrink: 0;
    }
    .mob-accordion-header.open .mob-acc-arrow { transform: rotate(180deg); }
    .mob-accordion-body {
      display: none;
      background: rgba(0,0,0,0.25);
    }
    .mob-accordion-body.open { display: block; }
    .mob-accordion-body a {
      display: block;
      padding: 0.65rem 1.5rem;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--grey-light);
      border-bottom: 1px solid rgba(255,255,255,0.04);
    }
    .mob-accordion-body a.sub { padding-left: 2.5rem; font-size: 0.78rem; color: var(--grey); }
    .mob-accordion-body a:hover { color: #ffffff; background: rgba(204,20,20,0.85); }
    .mob-main-link {
      display: block;
      padding: 1rem 1.5rem;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--grey-light);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .mob-main-link:hover { color: #ffffff; background: rgba(204,20,20,0.85); }

    /* ========== BOTTOM NAVBAR (mobile only) ========== */
    #bottom-nav {
      display: none;
      position: fixed;
      bottom: 0; left: 0; right: 0;
      height: 60px;
      background: rgba(10,10,10,0.98);
      border-top: 2px solid var(--red);
      z-index: 1001;
      backdrop-filter: blur(10px);
      justify-content: space-between;
      align-items: center;
      padding: 0 1rem;
    }
    @media (max-width: 768px) { #bottom-nav { display: flex; } }
    .bot-call-btn {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      background: var(--red);
      color: #fff;
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 0.5rem 1rem;
      border: 2px solid var(--red);
      white-space: nowrap;
      transition: background 0.2s, color 0.2s;
    }
    .bot-call-btn:hover { background: transparent; color: var(--red); }

    /* ========== HERO ========== */
    #home {
      min-height: 100vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      padding-top: 72px;
    }
    #home::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 180px;
      background: linear-gradient(to bottom, transparent 0%, #0f0f0f 100%);
      z-index: 2;
      pointer-events: none;
    }

    .hero-slide {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      transition: opacity 1.2s ease-in-out;
      opacity: 0;
    }
    .hero-slide.active { opacity: 1; }

    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(100deg, rgba(0,0,0,0.97) 0%, rgba(0,0,0,0.88) 55%, rgba(0,0,0,0.65) 100%);
      z-index: 1;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 1200px;
      width: 100%;
      padding: 5rem 2rem 4rem;
      margin: 0 auto;
    }

    @media (max-width: 768px) {
      #home { padding-top: 52px; }
      .hero-content {
        padding: 2rem 0.8rem 2.5rem;
      }
    }

    .hero-eyebrow {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--red);
      margin-bottom: 1.1rem;
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(2.8rem, 6vw, 5.5rem);
      line-height: 1;
      letter-spacing: 0.03em;
      color: #ffffff;
      margin-bottom: 1.6rem;
      max-width: 680px;
    }
    .hero-title .red { color: var(--red); }

    .hero-bullets {
      list-style: none;
      padding: 0;
      margin: 0 0 2.2rem;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      max-width: 560px;
    }
    .hero-bullets li {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-size: 1rem;
      color: rgba(255,255,255,0.85);
      line-height: 1.4;
    }
    .hero-bullets li::before {
      content: '';
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--red);
      flex-shrink: 0;
    }

    .hero-btns {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }

    .hero-badges {
      display: flex;
      align-items: stretch;
      margin-top: 1.8rem;
      flex-wrap: nowrap;
    }
    .hero-badge {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 20px;
      background: rgba(0,0,0,0.25);
      border: 1px solid rgba(255,255,255,0.06);
      backdrop-filter: blur(4px);
      transition: border-color 0.2s, background 0.2s;
      flex: 1;
      min-width: 0;
    }
    @media (max-width: 600px) {
      .hero-badges { margin-left: -2rem; margin-right: -2rem; }
      .hero-badge {
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: 5px;
        padding: 12px 6px;
      }
      .hero-badge-icon { width: 28px; height: 28px; }
      .hero-badge-threem { height: 28px; font-size: 10px; padding: 0 7px; }
      .hero-badge-avery { height: 28px; font-size: 8px; padding: 0 5px; }
      .hero-badge-counter { font-size: 16px; }
      .hero-badge-text { align-items: center; gap: 2px; }
      .hero-badge-title { font-size: 8px; letter-spacing: 0.04em; line-height: 1.2; }
      .hero-badge-sub, .hero-badge-verified { display: none; }
      .hero-badge-stars { justify-content: center; margin-top: 1px; }
      .hero-badge-star { font-size: 8px; }
    }
    .hero-badge + .hero-badge { border-left: none; }
    .hero-badge:hover { border-color: rgba(255,255,255,0.2); background: rgba(20,20,20,0.9); }
    .hero-badge-icon {
      flex-shrink: 0;
      width: 36px; height: 36px;
      display: flex; align-items: center; justify-content: center;
    }
    .hero-badge-threem {
      height: 36px;
      background: #cc0000;
      border-radius: 3px;
      display: flex; align-items: center; justify-content: center;
      font-size: 16px; font-weight: 900;
      color: #fff; letter-spacing: -0.3px;
      font-family: var(--font-body);
      padding: 0 9px;
      flex-shrink: 0;
    }
    .hero-badge-avery {
      height: 36px;
      background: #003DA5;
      border-radius: 3px;
      display: flex; align-items: center; justify-content: center;
      font-size: 10px; font-weight: 900;
      color: #fff; letter-spacing: 0.5px;
      font-family: var(--font-body);
      padding: 0 7px;
      flex-shrink: 0;
      text-transform: uppercase;
    }
    .hero-badge-counter {
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-display);
      font-size: 22px; color: var(--red);
      letter-spacing: 0.02em; line-height: 1;
    }
    .hero-badge-text { display: flex; flex-direction: column; gap: 2px; }
    .hero-badge-title {
      font-size: 11px; font-weight: 700;
      color: #fff; letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .hero-badge-sub { font-size: 10px; color: rgba(255,255,255,0.4); font-weight: 500; }
    .hero-badge-verified { font-size: 9px; color: var(--red); font-weight: 700; margin-top: 1px; }
    .hero-badge-stars { display: flex; gap: 2px; margin-top: 1px; }
    .hero-badge-star { color: #f4b400; font-size: 11px; line-height: 1; }

    .btn-primary {
      background: var(--red);
      color: #ffffff;
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      padding: 0.9rem 2.4rem;
      border: 2px solid var(--red);
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
      display: inline-block;
    }
    .btn-primary:hover { background: transparent; color: var(--red); }

    .btn-outline {
      background: transparent;
      color: var(--white);
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      padding: 0.9rem 2.4rem;
      border: 2px solid var(--grey-dark);
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s;
      display: inline-block;
    }
    .btn-outline:hover { border-color: var(--white); }

    /* ========== SECTION STYLES ========== */
    section { padding: 6rem 2rem; }

    .section-label {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--red);
      margin-bottom: 0.6rem;
    }
    .section-title {
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 5vw, 4rem);
      letter-spacing: 0.04em;
      line-height: 1;
      color: var(--white);
      margin-bottom: 1rem;
    }
    .section-desc {
      font-size: 1rem;
      color: var(--grey-light);
      max-width: 600px;
      line-height: 1.8;
    }

    .container { max-width: 1200px; margin: 0 auto; }

    /* ========== SERVICES OVERVIEW ========== */
    #services-overview {
      background: #0f0f0f;
      border-bottom: 1px solid #1e1e1e;
      padding: 3rem 0 4rem;
    }
    #services-overview .section-label { color: var(--red); }
    #services-overview .section-title { color: #ffffff; }
    #services-overview .section-desc { color: rgba(255,255,255,0.45); }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2px;
      background: #0a0a0a;
      margin-top: 2.5rem;
      border: 2px solid #0a0a0a;
    }

    .service-card {
      background: #222222;
      padding: 2.2rem 2rem 2rem;
      cursor: pointer;
      transition: background 0.2s ease;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      border-left: 3px solid rgba(204,20,20,0.45);
    }
    .service-card:hover {
      background: #2a2a2a;
      border-left-color: var(--red);
    }
    .service-card::after {
      content: attr(data-num);
      position: absolute;
      right: 1rem; bottom: -0.8rem;
      font-family: var(--font-display);
      font-size: 6rem;
      font-weight: 900;
      color: rgba(255,255,255,0.06);
      line-height: 1;
      pointer-events: none;
      letter-spacing: -0.05em;
      user-select: none;
    }
    .service-card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 1.1rem;
    }
    .service-card h3 {
      font-family: var(--font-display);
      font-size: 2rem;
      letter-spacing: 0.04em;
      color: #ffffff;
      line-height: 1;
    }
    .service-card-arrow {
      width: 32px;
      height: 32px;
      border: 1px solid rgba(204,20,20,0.35);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--red);
      font-size: 0.9rem;
      flex-shrink: 0;
      transition: background 0.2s, border-color 0.2s, transform 0.2s;
    }
    .service-card:hover .service-card-arrow {
      background: var(--red);
      border-color: var(--red);
      color: #fff;
      transform: translateX(3px);
    }
    .service-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .service-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.5);
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.12);
      padding: 0.28rem 0.6rem;
      border-radius: 2px;
      transition: color 0.15s, border-color 0.15s;
    }
    .service-card:hover .service-tag {
      color: rgba(255,255,255,0.75);
      border-color: rgba(255,255,255,0.2);
    }
    .service-tag svg { flex-shrink: 0; opacity: 0.7; }
    .service-card .card-link { display: none; }

    @media (max-width: 768px) {
      #services-overview { padding: 2.5rem 1rem; }
      .services-grid {
        grid-template-columns: 1fr;
      }
      .service-card {
        padding: 1.6rem 1.4rem;
        border-left-width: 3px;
      }
      .service-card h3 { font-size: 1.6rem; }
      .service-card::after { display: none; }
      .service-card-head { margin-bottom: 0.8rem; }
      .service-tag { font-size: 0.63rem; }
    }

    /* ========== PORTFOLIO PREVIEW ========== */
    #portfolio-preview {
      background: var(--dark);
      padding: 5rem 2rem;
      border-bottom: 1px solid var(--grey-dark);
    }
    @media (max-width: 768px) {
      #portfolio-preview { padding: 3rem 1.2rem; }
    }
    .portfolio-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }
    .portfolio-header .section-title { margin-bottom: 0; }
    .btn-outline-red {
      display: inline-block;
      border: 2px solid var(--red);
      color: var(--red);
      background: transparent;
      padding: 0.75rem 1.6rem;
      font-family: var(--font-display);
      font-size: 0.8rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      white-space: nowrap;
      transition: background 0.2s, color 0.2s;
      flex-shrink: 0;
    }
    .btn-outline-red:hover { background: var(--red); color: #fff; }
    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: 280px 280px;
      gap: 0.75rem;
    }
    .portfolio-item {
      position: relative;
      overflow: hidden;
      cursor: pointer;
      background: var(--dark2);
    }
    .portfolio-item--featured { grid-column: span 2; }
    .portfolio-item img {
      width: 100%; height: 100%;
      object-fit: contain;
      object-position: center;
      display: block;
      transition: transform 0.4s ease;
    }
    .portfolio-item:hover img { transform: scale(1.05); }
    .portfolio-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 55%);
      display: flex;
      align-items: flex-end;
      padding: 1.4rem 1.6rem;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .portfolio-item:hover .portfolio-overlay { opacity: 1; }
    .portfolio-overlay span {
      font-family: var(--font-display);
      font-size: 1rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #fff;
    }
    @media (max-width: 720px) {
      .portfolio-grid {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 180px 180px;
      }
      .portfolio-item--featured { grid-column: span 2; }
    }

    /* ========== WHY FLY VISUALS ========== */
    #why {
      background: var(--black);
    }

    .why-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: center;
      margin-top: 1rem;
    }

    .why-list { margin-top: 2rem; display: flex; flex-direction: column; gap: 1.5rem; }
    .why-item { display: flex; gap: 1rem; align-items: flex-start; }
    .why-icon {
      flex-shrink: 0;
      width: 44px;
      height: 44px;
      background: rgba(204,20,20,0.1);
      border: 1px solid rgba(204,20,20,0.25);
      border-radius: 3px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--red);
    }
    .why-item h4 {
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 0.3rem;
      color: var(--white);
    }
    .why-item p { font-size: 0.9rem; color: var(--grey); }

    .why-visual {
      position: relative;
      height: 480px;
      background: #0f0f0f;
      border: 1px solid #222;
      border-left: 3px solid var(--red);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    /* dot-grid texture */
    .why-visual::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle, rgba(255,255,255,0.055) 1px, transparent 1px);
      background-size: 20px 20px;
      pointer-events: none;
    }
    /* top-right corner glow */
    .why-visual::after {
      content: '';
      position: absolute;
      top: -80px; right: -80px;
      width: 320px; height: 320px;
      background: radial-gradient(circle, rgba(204,20,20,0.09) 0%, transparent 65%);
      pointer-events: none;
    }
    .why-vis-rings {
      position: absolute;
      bottom: -60px; right: -60px;
      width: 260px; height: 260px;
      border: 1px solid rgba(204,20,20,0.1);
      border-radius: 50%;
    }
    .why-vis-rings::before {
      content: '';
      position: absolute;
      inset: 28px;
      border: 1px solid rgba(204,20,20,0.07);
      border-radius: 50%;
    }
    .why-vis-rings::after {
      content: '';
      position: absolute;
      inset: 56px;
      border: 1px solid rgba(204,20,20,0.05);
      border-radius: 50%;
    }
    .why-vis-content {
      position: relative;
      z-index: 1;
      text-align: center;
      padding: 2rem;
    }
    .why-vis-eyebrow {
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: var(--red);
      margin-bottom: 1.1rem;
    }
    .why-vis-brand {
      font-family: var(--font-display);
      font-size: clamp(4rem, 7vw, 6rem);
      line-height: 0.88;
      color: #ffffff;
      letter-spacing: 0.06em;
      margin-bottom: 1.4rem;
    }
    .why-vis-rule {
      width: 36px;
      height: 2px;
      background: var(--red);
      margin: 0 auto 1.4rem;
    }
    .why-vis-tagline {
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.35);
      margin-bottom: 2rem;
    }
    .why-vis-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(204,20,20,0.1);
      border: 1px solid rgba(204,20,20,0.28);
      padding: 0.5rem 1.1rem;
      border-radius: 2px;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.65);
    }
    .why-vis-badge svg { color: var(--red); flex-shrink: 0; }

    /* ========== WHY FORM PANEL ========== */
    .why-form-panel {
      position: relative;
      background: #ffffff;
      border: 1px solid #e0e0e0;
      border-left: 3px solid var(--red);
      overflow: hidden;
      padding: 2.2rem 2.2rem 2rem 2.4rem;
      box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    }
    .why-form-panel::before { display: none; }
    .why-form-panel::after {
      content: '';
      position: absolute;
      top: -80px; right: -80px;
      width: 300px; height: 300px;
      background: radial-gradient(circle, rgba(204,20,20,0.04) 0%, transparent 65%);
      pointer-events: none;
    }
    .wfp-header {
      position: relative;
      z-index: 1;
      margin-bottom: 1.4rem;
    }
    .wfp-eyebrow {
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--red);
      margin-bottom: 0.5rem;
    }
    .wfp-title {
      font-family: var(--font-display);
      font-size: clamp(2.2rem, 4vw, 3rem);
      line-height: 0.88;
      color: #1a1a1a;
      letter-spacing: 0.04em;
      margin-bottom: 0.65rem;
    }
    .wfp-title span { color: var(--red); }
    .wfp-sub {
      font-size: 0.82rem;
      color: #888;
      line-height: 1.5;
    }
    .wfp-field {
      position: relative;
      z-index: 1;
      margin-bottom: 0.7rem;
    }
    .wfp-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.7rem;
    }
    .wfp-row .wfp-field { margin-bottom: 0.7rem; }
    .wfp-field input,
    .wfp-field select,
    .wfp-field textarea {
      width: 100%;
      background: #f5f5f5;
      border: 1px solid #ddd;
      color: #1a1a1a;
      font-family: var(--font-body);
      font-size: 0.85rem;
      padding: 0.7rem 1rem;
      outline: none;
      transition: border-color 0.2s, background 0.2s;
      -webkit-appearance: none;
      appearance: none;
      border-radius: 0;
    }
    .wfp-field input::placeholder,
    .wfp-field textarea::placeholder { color: #aaa; }
    .wfp-field select { color: #aaa; cursor: pointer; }
    .wfp-field select.wfp-filled { color: #1a1a1a; }
    .wfp-field input:focus,
    .wfp-field select:focus,
    .wfp-field textarea:focus {
      border-color: var(--red);
      background: #fff;
    }
    .wfp-field textarea { resize: vertical; min-height: 76px; }
    .wfp-error-msg {
      position: relative;
      z-index: 1;
      font-size: 0.8rem;
      color: #cc1414;
      background: rgba(204,20,20,0.05);
      border: 1px solid rgba(204,20,20,0.2);
      padding: 0.55rem 0.9rem;
      margin-bottom: 0.7rem;
    }
    .wfp-btn {
      position: relative;
      z-index: 1;
      width: 100%;
      background: var(--red);
      color: #fff;
      border: none;
      font-family: var(--font-body);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 0.95rem 1.5rem;
      cursor: pointer;
      transition: background 0.2s;
      margin-bottom: 0.6rem;
    }
    .wfp-btn:hover { background: #a81010; }
    .wfp-btn:disabled { opacity: 0.6; cursor: not-allowed; }
    .wfp-privacy {
      position: relative;
      z-index: 1;
      font-size: 0.7rem;
      color: #bbb;
      text-align: center;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .wfp-success-state {
      position: relative;
      z-index: 1;
      text-align: center;
      padding: 2.5rem 1rem;
    }
    .wfp-success-icon {
      width: 52px; height: 52px;
      background: rgba(204,20,20,0.08);
      border: 1px solid rgba(204,20,20,0.25);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      color: var(--red);
      margin: 0 auto 1rem;
    }
    .wfp-success-title {
      font-family: var(--font-display);
      font-size: 1.7rem;
      color: #1a1a1a;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
    }
    .wfp-success-state p { font-size: 0.85rem; color: #888; line-height: 1.6; }

    /* ========== PAGE SECTIONS (hidden by default) ========== */
    .page-section {
      display: none;
      animation: fadeIn 0.3s ease;
    }
    .page-section.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    /* ========== SERVICE PAGE HERO ========== */
    .page-hero {
      min-height: 45vh;
      display: flex;
      align-items: center;
      padding: 8rem 2rem 4rem;
      background:
        linear-gradient(160deg, #1a1a1a 0%, #111111 40%, #0d0d0d 100%);
      position: relative;
      overflow: hidden;
      border-bottom: 2px solid var(--red);
    }
    .page-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(255,255,255,0.018) 2px,
          rgba(255,255,255,0.018) 4px
        ),
        repeating-linear-gradient(
          90deg,
          transparent,
          transparent 2px,
          rgba(255,255,255,0.018) 2px,
          rgba(255,255,255,0.018) 4px
        );
      background-size: 4px 4px;
    }
    .page-hero-content { position: relative; max-width: 1200px; margin: 0 auto; }
    .page-hero h1 {
      font-family: var(--font-display);
      font-size: clamp(3rem, 7vw, 6rem);
      letter-spacing: 0.04em;
      line-height: 0.95;
      color: #ffffff;
      margin-bottom: 1rem;
    }
    .page-hero h1 span { color: var(--red); }
    .page-hero p {
      font-size: 1.05rem;
      color: rgba(255,255,255,0.75);
      max-width: 600px;
      line-height: 1.8;
    }
.breadcrumb {
      font-size: 0.72rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.5);
      margin-bottom: 1.2rem;
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }
    .breadcrumb span { color: var(--red); }

    /* ========== CONTENT SECTIONS ========== */
    .content-block { padding: 5rem 2rem; }
    .content-block.alt { background: var(--dark2); }

    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
      max-width: 1200px;
      margin: 0 auto;
    }
    .two-col.reverse { direction: rtl; }
    .two-col.reverse > * { direction: ltr; }

    .content-img {
      width: 100%;
      aspect-ratio: 4/3;
      background: var(--dark);
      border: 1px solid var(--grey-dark);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }
    .content-img-placeholder {
      font-family: var(--font-display);
      font-size: 1.2rem;
      letter-spacing: 0.15em;
      color: var(--grey-dark);
      text-align: center;
    }
    .content-img::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(204,20,20,0.05) 0%, transparent 60%);
      pointer-events: none;
      z-index: 2;
    }

    /* ===== PAGE SLIDESHOW ===== */
    .page-slideshow {
      position: relative;
      width: 100%;
      aspect-ratio: 4/3;
      overflow: hidden;
      background: var(--dark);
      border: 1px solid var(--grey-dark);
    }
    .page-slideshow-track {
      display: flex;
      height: 100%;
      transition: transform 0.5s ease;
    }
    .page-slideshow-slide {
      min-width: 100%;
      height: 100%;
      position: relative;
      overflow: hidden;
    }
    .page-slideshow-slide img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .page-slideshow-slide .content-img-placeholder {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .page-slideshow-btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 3;
      background: rgba(0,0,0,0.55);
      border: 1px solid rgba(255,255,255,0.15);
      color: var(--white);
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 1rem;
      transition: background 0.2s;
    }
    .page-slideshow-btn:hover { background: var(--red); border-color: var(--red); }
    .page-slideshow-btn.prev { left: 10px; }
    .page-slideshow-btn.next { right: 10px; }
    .page-slideshow-dots {
      position: absolute;
      bottom: 10px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 6px;
      z-index: 3;
    }
    .page-slideshow-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: rgba(255,255,255,0.35);
      cursor: pointer;
      transition: background 0.2s, transform 0.2s;
      border: none;
    }
    .page-slideshow-dot.active {
      background: var(--red);
      transform: scale(1.3);
    }
    /* Hide nav when only 1 slide */
    .page-slideshow[data-count="1"] .page-slideshow-btn,
    .page-slideshow[data-count="1"] .page-slideshow-dots { display: none; }

    .content-text h2 {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3rem);
      letter-spacing: 0.04em;
      color: var(--white);
      margin-bottom: 1rem;
      line-height: 1;
    }
    .content-text h2 span { color: var(--red); }
    .content-text p { color: var(--grey-light); line-height: 1.8; margin-bottom: 1rem; font-size: 0.95rem; }

    .read-more-wrap { display: none; }
    .read-more-wrap.open { display: block; }
    .read-more-btn { background: none; border: none; color: var(--red); cursor: pointer; font-size: 0.85rem; font-family: var(--font-body); font-weight: 600; padding: 0.2rem 0; margin: 0.5rem auto 1rem; letter-spacing: 0.02em; display: block; text-align: center; width: 100%; }
    .read-more-btn:hover { text-decoration: underline; }

    .inline-badges { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 1.2rem; align-items: center; }
    .inline-badge { display: flex; align-items: center; gap: 0.5rem; font-size: 0.78rem; color: var(--grey); }

    .feature-list { margin: 1.5rem 0; display: flex; flex-direction: column; gap: 0.6rem; }
    .feature-list li {
      list-style: none;
      display: flex;
      align-items: center;
      gap: 0.7rem;
      font-size: 0.9rem;
      color: var(--grey-light);
    }
    .feature-list li::before {
      content: '';
      display: inline-block;
      width: 8px; height: 8px;
      background: var(--red);
      flex-shrink: 0;
    }

    /* ========== CARDS GRID ========== */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1px;
      background: var(--grey-dark);
      margin-top: 3rem;
      max-width: 1200px;
      margin-left: auto;
      margin-right: auto;
    }
    .info-card {
      background: var(--dark);
      padding: 2rem 1.8rem;
      transition: background 0.2s;
    }
    .info-card:hover { background: var(--red); color: #ffffff; }
    .info-card h3 {
      font-family: var(--font-display);
      font-size: 1.5rem;
      letter-spacing: 0.05em;
      color: var(--white);
      margin-bottom: 0.6rem;
    }
    .info-card p { font-size: 0.88rem; color: var(--grey); line-height: 1.7; }
    @media (max-width: 720px) {
      #vehicle-wraps-page .cards-grid .info-card p { display: none; }
    }

    /* ========== LOCAL AREAS ========== */
    .areas-section {
      background: var(--dark2);
      border-top: 1px solid var(--grey-dark);
      padding: 4rem 2rem;
      text-align: center;
    }
    .areas-section .section-title { font-size: 2rem; margin-bottom: 2rem; }
    .areas-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      justify-content: center;
      max-width: 900px;
      margin: 0 auto;
    }
    .area-tag {
      background: var(--dark);
      border: 1px solid var(--grey-dark);
      color: var(--grey-light);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.5rem 1rem;
    }

    /* ========== CTA BAND ========== */
    /* ========== PRICE MATCH BAND ========== */
    .price-match-band {
      background: #111;
      border-top: 1px solid #1e1e1e;
      border-bottom: 1px solid #1e1e1e;
      padding: 2.4rem 2rem;
    }
    .price-match-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 2.5rem;
      flex-wrap: wrap;
    }
    .price-match-icon {
      font-size: 2.2rem;
      line-height: 1;
      flex-shrink: 0;
    }
    .price-match-copy { flex: 1; min-width: 260px; }
    .price-match-eyebrow {
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--red);
      margin-bottom: 0.35rem;
    }
    .price-match-headline {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 2.5vw, 2.1rem);
      color: #fff;
      letter-spacing: 0.04em;
      line-height: 1.05;
      margin-bottom: 0.3rem;
    }
    .price-match-sub {
      font-size: 0.85rem;
      color: #888;
      line-height: 1.5;
    }
    .price-match-sub strong { color: #ccc; font-weight: 600; }
    @media (max-width: 600px) {
      .price-match-inner { flex-direction: column; align-items: flex-start; gap: 1.2rem; }
      .price-match-icon { display: none; }
    }

    .cta-band {
      background: var(--red);
      padding: 4rem 2rem;
      text-align: center;
    }
    .cta-band h2 {
      font-family: var(--font-display);
      font-size: clamp(2rem, 5vw, 3.5rem);
      letter-spacing: 0.05em;
      color: var(--white);
      margin-bottom: 0.6rem;
    }
    .cta-band p { color: rgba(255,255,255,0.8); margin-bottom: 2rem; font-size: 1rem; }
    .btn-white {
      background: var(--white);
      color: var(--red);
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      padding: 0.9rem 2.4rem;
      border: 2px solid var(--white);
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
      display: inline-block;
    }
    .btn-white:hover { background: transparent; color: #ffffff; }

    .hero-text-link {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      color: rgba(255,255,255,0.65);
      font-family: var(--font-body);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-decoration: none;
      border-bottom: 1px solid rgba(255,255,255,0.2);
      padding-bottom: 2px;
      transition: color 0.2s, border-color 0.2s;
    }
    .hero-text-link:hover {
      color: #ffffff;
      border-color: rgba(255,255,255,0.6);
    }
    .hero-text-link svg {
      flex-shrink: 0;
      transition: transform 0.2s;
    }
    .hero-text-link:hover svg { transform: translateX(3px); }

    /* ========== GALLERY ========== */
    /* ========== GALLERY TABS ========== */
    .gallery-tabs-header {
      max-width: 1200px;
      margin: 0 auto 2rem;
    }
    .gallery-tabs-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 2.8rem);
      letter-spacing: 0.06em;
      color: var(--dark);
      line-height: 1;
      margin-bottom: 0.5rem;
    }
    .gallery-tabs-sub {
      font-size: 0.88rem;
      color: var(--grey);
      line-height: 1.5;
    }
    .gallery-tabs {
      display: flex;
      gap: 0;
      border-bottom: 1px solid #ddd;
      margin-bottom: 0;
      max-width: 1200px;
      margin-left: auto;
      margin-right: auto;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .gallery-tabs::-webkit-scrollbar { display: none; }
    .gallery-tab {
      flex-shrink: 0;
      padding: 0.8rem 1.5rem;
      font-family: var(--font-body);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #888;
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      cursor: pointer;
      transition: color 0.2s, border-color 0.2s;
      white-space: nowrap;
    }
    .gallery-tab:hover { color: #1a1a1a; }
    .gallery-tab.active {
      color: #1a1a1a;
      border-bottom-color: var(--red);
    }
    .gallery-tab-count {
      display: inline-block;
      background: rgba(204,20,20,0.12);
      color: var(--red);
      font-size: 0.65rem;
      font-weight: 700;
      padding: 1px 5px;
      margin-left: 5px;
      letter-spacing: 0.05em;
    }
    .gallery-tab.active .gallery-tab-count {
      background: var(--red);
      color: #fff;
    }

    #gallery-page .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 12px;
      max-width: 1200px;
      margin: 1.5rem auto 0;
    }
    .gallery-item {
      position: relative;
      overflow: hidden;
      background: var(--dark2);
      border: 1px solid var(--grey-dark);
      cursor: pointer;
    }
    .gallery-item img {
      width: 100%;
      aspect-ratio: 4/3;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }
    .gallery-item:hover img { transform: scale(1.04); }
    .gallery-caption {
      padding: 0.75rem 1rem;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--grey-light);
      background: var(--dark2);
      border-top: 2px solid var(--red);
    }

    /* ========== CONTACT ========== */
    #contact-page .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      gap: 4rem;
      max-width: 1100px;
      margin: 3rem auto 0;
    }

    .contact-info h3 {
      font-family: var(--font-display);
      font-size: 1.6rem;
      letter-spacing: 0.05em;
      margin-bottom: 1.5rem;
    }
    .contact-detail {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 1.2rem;
    }
    .contact-detail-icon { font-size: 1.2rem; }
    .contact-detail-text { font-size: 0.9rem; color: var(--grey-light); line-height: 1.6; }
    .contact-detail-text strong { display: block; color: var(--white); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.2rem; }

    .contact-form { display: flex; flex-direction: column; gap: 1rem; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
    .form-group label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--grey);
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      background: var(--dark2);
      border: 1px solid var(--grey-dark);
      color: var(--white);
      font-family: var(--font-body);
      font-size: 0.95rem;
      padding: 0.8rem 1rem;
      outline: none;
      transition: border-color 0.2s;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus { border-color: var(--red); }
    .form-group select option { background: var(--dark2); }
    .form-group textarea { resize: vertical; min-height: 120px; }

    /* ========== FOOTER ========== */
    footer {
      background: var(--dark2);
      border-top: 2px solid var(--red);
      padding: 4rem 2rem 2rem;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
      gap: 2.5rem;
      max-width: 1200px;
      margin: 0 auto 3rem;
    }
    .footer-brand .logo { font-size: 1.8rem; margin-bottom: 1rem; }
    .footer-brand p { font-size: 0.88rem; color: var(--grey); line-height: 1.7; max-width: 280px; }
    .footer-info { margin-top: 1.4rem; display: flex; flex-direction: column; gap: 0.85rem; }
    .footer-info-row {
      display: flex;
      align-items: flex-start;
      gap: 0.65rem;
      font-size: 0.82rem;
      color: var(--grey);
      line-height: 1.5;
    }
    .footer-info-row svg { flex-shrink: 0; margin-top: 2px; color: var(--red); }
    .footer-info-row a { color: var(--grey); transition: color 0.2s; }
    .footer-info-row a:hover { color: var(--white); }
    .footer-directions {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      margin-top: 0.3rem;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--red);
      transition: opacity 0.2s;
    }
    .footer-directions:hover { opacity: 0.75; }
    .footer-hours-grid {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.1rem 0.8rem;
      font-size: 0.8rem;
    }
    .footer-hours-day { color: rgba(102,102,102,0.8); }
    .footer-hours-time { color: var(--grey); }
    .footer-col h4 {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--red);
      margin-bottom: 1.2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .footer-col-arrow {
      width: 10px; height: 10px;
      display: none;
      transition: transform 0.25s;
      flex-shrink: 0;
    }
    .footer-col h4.open .footer-col-arrow { transform: rotate(180deg); }

    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
    .footer-col ul li a {
      font-size: 0.85rem;
      color: var(--grey);
      transition: color 0.2s;
    }
    .footer-col ul li a:hover { color: #ffffff; }

    @media (max-width: 768px) {
      .footer-col { border-bottom: 1px solid var(--grey-dark); padding-bottom: 0; }
      .footer-col h4 { cursor: pointer; padding: 1rem 0; margin-bottom: 0; }
      .footer-col-arrow { display: block; }
      .footer-col ul { display: none; padding-bottom: 0.8rem; }
      .footer-col ul.open { display: flex; }

      .footer-brand {
        border-bottom: 1px solid var(--grey-dark);
        padding-bottom: 2rem;
        text-align: center;
      }
      .footer-brand img { height: 68px !important; margin-bottom: 1rem !important; }
      .footer-brand p { font-size: 0.9rem; max-width: 100%; color: var(--grey); }

      .footer-info {
        align-items: center;
        gap: 1.4rem;
        margin-top: 1.8rem;
      }
      .footer-info-row {
        justify-content: center;
        font-size: 0.95rem;
        text-align: center;
      }
      .footer-info-row > div {
        text-align: center;
      }
      .footer-info-row svg { display: none; }

      .footer-directions {
        font-size: 0.8rem;
        padding: 0.55rem 1.4rem;
        background: rgba(204,20,20,0.1);
        border: 1px solid rgba(204,20,20,0.3);
        border-radius: 2px;
        display: inline-flex;
        margin-top: 0.6rem;
        letter-spacing: 0.12em;
      }

      .footer-hours-grid {
        font-size: 0.92rem;
        gap: 0.25rem 1.2rem;
        justify-content: center;
      }
      .footer-hours-day { text-align: right; }
      .footer-hours-time { text-align: left; }
    }

    .footer-bottom {
      max-width: 1200px;
      margin: 0 auto;
      padding-top: 2rem;
      border-top: 1px solid var(--grey-dark);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .footer-bottom p { font-size: 0.78rem; color: var(--grey); }

    /* ========== SOCIAL PROOF ========== */
    .reviews-section {
      background: var(--dark2);
      padding: 3.5rem 2rem 3rem;
      border-top: 1px solid var(--grey-dark);
      border-bottom: 1px solid var(--grey-dark);
    }
    .reviews-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      max-width: 1200px;
      margin: 0 auto 2rem;
    }
    .reviews-header-left { display: flex; flex-direction: column; gap: 0.3rem; }
    .google-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      padding: 0.5rem 1rem;
      border-radius: 3px;
    }
    .google-badge-logo {
      font-size: 1rem;
      font-weight: 900;
      letter-spacing: -0.02em;
    }
    .google-badge-logo .g-blue { color: #4285F4; }
    .google-badge-logo .g-red { color: #EA4335; }
    .google-badge-logo .g-yellow { color: #FBBC05; }
    .google-badge-logo .g-green { color: #34A853; }
    .google-badge-text { font-size: 0.72rem; color: var(--grey-light); letter-spacing: 0.04em; }
    .google-badge-text strong { color: #FBBC05; font-size: 0.78rem; }
    .stars-row { display: flex; gap: 3px; color: #FBBC05; font-size: 1.3rem; justify-content: center; margin-bottom: 0.4rem; }
    .rating-line { font-size: 0.78rem; color: var(--grey); letter-spacing: 0.1em; text-transform: uppercase; }
    .reviews-header .section-label { margin-bottom: 0.2rem; }
    .reviews-header .section-title { font-size: clamp(1.4rem, 3vw, 2rem); margin: 0; }

    .reviews-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1px;
      background: var(--grey-dark);
      max-width: 1200px;
      margin: 0 auto 3rem;
    }

    /* ========== REVIEW CAROUSEL ========== */
    .review-carousel-wrap {
      display: flex;
      align-items: stretch;
      gap: 0;
      max-width: 1200px;
      margin: 0 auto 1rem;
      position: relative;
    }
    .review-carousel-viewport {
      overflow: hidden;
      flex: 1;
    }
    .review-carousel-track {
      display: flex;
      transition: transform 0.45s cubic-bezier(0.4,0,0.2,1);
    }
    .carousel-slide {
      flex: 0 0 100%;
      min-width: 0;
    }
    @media (min-width: 700px) {
      .carousel-slide { flex: 0 0 50%; }
    }
    @media (min-width: 1000px) {
      .carousel-slide { flex: 0 0 33.333%; }
    }
    .carousel-btn {
      background: transparent;
      border: none;
      border-left: 1px solid var(--grey-dark);
      color: rgba(255,255,255,0.4);
      font-size: 1.1rem;
      width: 36px;
      min-width: 36px;
      cursor: pointer;
      transition: color 0.2s, background 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
    }
    .carousel-prev { border-left: none; border-right: 1px solid var(--grey-dark); }
    .carousel-btn:hover { color: var(--red); }
    .carousel-dots {
      display: flex;
      justify-content: center;
      gap: 5px;
      margin-bottom: 0;
      padding-top: 0.8rem;
    }
    .carousel-dot {
      width: 5px; height: 5px;
      border-radius: 50%;
      background: var(--grey-dark);
      border: none;
      cursor: pointer;
      transition: background 0.2s, transform 0.2s, width 0.2s;
      padding: 0;
    }
    .carousel-dot.active { background: var(--red); width: 18px; border-radius: 3px; }
    .review-card {
      background: var(--dark);
      padding: 1.4rem 1.6rem;
      position: relative;
      border-right: 1px solid var(--grey-dark);
      border-bottom: 1px solid var(--grey-dark);
    }
    .review-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 3px; height: 100%;
      background: var(--red);
      opacity: 0.6;
    }
    .review-stars { display: flex; gap: 2px; color: #FBBC05; font-size: 0.8rem; margin-bottom: 0.6rem; }
    .review-text {
      font-size: 0.82rem;
      color: var(--grey-light);
      line-height: 1.65;
      font-style: italic;
      margin-bottom: 1rem;
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .review-text::before { content: '\201C'; font-size: 2rem; color: var(--red); line-height: 0; vertical-align: -0.5rem; margin-right: 0.15rem; font-style: normal; font-family: var(--font-display); opacity: 0.7; }
    .reviewer {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding-top: 0.8rem;
      border-top: 1px solid rgba(255,255,255,0.05);
    }
    .reviewer-avatar {
      width: 28px; height: 28px;
      border-radius: 50%;
      background: var(--red-dark);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-display);
      font-size: 0.85rem;
      color: #fff;
      flex-shrink: 0;
    }
    .reviewer-name { font-size: 0.78rem; font-weight: 700; color: var(--white); }
    .reviewer-meta { font-size: 0.65rem; color: var(--grey); letter-spacing: 0.04em; }
    .google-verified { font-size: 0.62rem; color: #4285F4; letter-spacing: 0.06em; text-transform: uppercase; margin-top: 1px; }

    @media (max-width: 768px) {
      .reviews-section { padding: 2.5rem 1.2rem 2rem; }
      .reviews-header { flex-direction: column; align-items: flex-start; gap: 0.6rem; margin-bottom: 1.2rem; }
    }

    /* ========== TRUST BAR ========== */
    .trust-bar {
      background: var(--dark2);
      border-top: 1px solid var(--grey-dark);
      border-bottom: 1px solid var(--grey-dark);
      padding: 2rem 2rem;
    }
    .trust-bar-inner {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0;
      max-width: 1100px;
      margin: 0 auto;
    }
    .trust-item {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 0.8rem 2rem;
      border-right: 1px solid var(--grey-dark);
      flex: 1;
      min-width: 180px;
    }
    .trust-item:last-child { border-right: none; }
    .trust-icon { font-size: 1.5rem; flex-shrink: 0; }
    .trust-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--white); }
    .trust-sub { font-size: 0.7rem; color: var(--grey); margin-top: 0.1rem; }

    @media (max-width: 768px) {
      .trust-bar { padding: 1.5rem 1rem; }
      .trust-bar-inner { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--grey-dark); border: 1px solid var(--grey-dark); }
      .trust-item { border-right: none; background: var(--dark2); padding: 1rem 0.8rem; flex-direction: column; align-items: center; text-align: center; gap: 0.4rem; min-width: unset; }
      .trust-icon { font-size: 1.4rem; }
      .trust-label { font-size: 0.62rem; letter-spacing: 0.08em; }
      .trust-sub { font-size: 0.6rem; }
    }

    /* ========== PRICING SECTION ========== */
    .pricing-section {
      background: var(--black);
      padding: 5rem 2rem;
      border-top: 1px solid var(--grey-dark);
      position: relative;
      overflow: hidden;
    }
    .pricing-section::before {
      content: '';
      position: absolute;
      top: 0; left: 50%;
      transform: translateX(-50%);
      width: 600px; height: 300px;
      background: radial-gradient(ellipse, rgba(204,20,20,0.08) 0%, transparent 70%);
      pointer-events: none;
    }
    .pricing-header { text-align: center; margin-bottom: 3.5rem; position: relative; }
    .pricing-header .section-label { margin-bottom: 0.5rem; }
    .pricing-header h2 { font-family: var(--font-display); font-size: clamp(2rem,4vw,3rem); letter-spacing:0.04em; color:var(--white); margin-bottom:0.8rem; }
    .pricing-header p { color: var(--grey); font-size:0.95rem; max-width:560px; margin:0 auto; line-height:1.8; }

    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
      max-width: 1100px;
      margin: 0 auto 2.5rem;
      position: relative;
    }
    .pricing-card {
      background: var(--dark2);
      border: 1px solid var(--grey-dark);
      padding: 2.2rem 2rem 2rem;
      display: flex;
      flex-direction: column;
      position: relative;
      transition: border-color 0.25s, transform 0.25s;
    }
    .pricing-card:hover {
      border-color: rgba(204,20,20,0.5);
      transform: translateY(-3px);
    }
    .pricing-card.featured {
      background: var(--dark2);
      border: 2px solid var(--red);
      transform: translateY(-4px);
    }
    .pricing-card.featured:hover { transform: translateY(-7px); }

    .pricing-badge {
      display: inline-block;
      background: var(--red);
      color: var(--white);
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      padding: 0.3rem 0.8rem;
      margin-bottom: 1.2rem;
      align-self: flex-start;
    }
    .pricing-coverage {
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--red);
      margin-bottom: 0.5rem;
    }
    .pricing-card h3 {
      font-family: var(--font-display);
      font-size: 1.8rem;
      letter-spacing: 0.04em;
      color: var(--white);
      margin-bottom: 1rem;
      line-height: 1;
    }
    .pricing-divider {
      width: 2rem;
      height: 2px;
      background: var(--red);
      margin-bottom: 1rem;
    }
    .pricing-card p {
      font-size: 0.88rem;
      color: var(--grey);
      line-height: 1.75;
      flex: 1;
      margin-bottom: 1.8rem;
    }
    .pricing-price {
      display: flex;
      align-items: flex-end;
      gap: 0.3rem;
      margin-top: auto;
    }
    .pricing-price-label {
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--grey);
      margin-bottom: 0.35rem;
      flex-shrink: 0;
    }
    .pricing-price-amount {
      font-family: var(--font-display);
      font-size: 2.4rem;
      letter-spacing: 0.02em;
      color: var(--white);
      line-height: 1;
    }
    .pricing-card.featured .pricing-price-amount { color: var(--red); }
    .pricing-note {
      text-align: center;
      font-size: 0.78rem;
      color: var(--grey);
      max-width: 620px;
      margin: 0 auto;
      line-height: 1.7;
      position: relative;
    }

    @media (max-width: 768px) {
      .pricing-grid { grid-template-columns: 1fr; gap: 1rem; }
      .pricing-card.featured { transform: none; }
      .pricing-card:hover { transform: none; }
    }

    /* ========== FAQ ACCORDION ========== */
    .faq-accordion { display: flex; flex-direction: column; gap: 0; border: 1px solid var(--grey-dark); }
    .faq-item { border-bottom: 1px solid var(--grey-dark); }
    .faq-item:last-child { border-bottom: none; }
    .faq-question {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.2rem 1.5rem;
      cursor: pointer;
      background: var(--dark);
      border: none;
      width: 100%;
      text-align: left;
      transition: background 0.2s;
    }
    .faq-question:hover { background: var(--red); color: #ffffff; }
    .faq-question:hover .faq-question-text { color: #ffffff; }
    .faq-question.open { background: #1a0000; border-left: 3px solid var(--red); }
    .faq-question-text {
      font-family: var(--font-body);
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--white);
      line-height: 1.5;
    }
    .faq-question.open .faq-question-text { color: #ffffff; }
    .faq-icon {
      width: 20px; height: 20px;
      min-width: 20px;
      border: 1px solid var(--grey-dark);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 1rem;
      color: var(--red);
      font-weight: 300;
      transition: transform 0.25s, background 0.2s;
      line-height: 1;
    }
    .faq-question.open .faq-icon { transform: rotate(45deg); background: var(--red); color: #ffffff; border-color: var(--red); }
    .faq-answer {
      display: none;
      padding: 0 1.5rem 1.4rem 1.5rem;
      background: #1a0000;
      border-left: 3px solid var(--red);
    }
    .faq-answer.open { display: block; }
    .faq-answer p { font-size: 0.9rem; color: rgba(255,255,255,0.75); line-height: 1.8; margin: 0; }

    /* ========== RESPONSIVE ========== */
    @media (max-width: 1024px) {
      .why-grid { grid-template-columns: 1fr; }
      .why-visual { height: 300px; }
      .footer-grid { grid-template-columns: 1fr 1fr 1fr; }
    }

    @media (max-width: 768px) {
      nav { display: none; }
      /* ---- Top navbar mobile layout ---- */
      #navbar {
        overflow: visible;
        justify-content: space-between;
        height: 52px;
      }
      .logo {
        position: fixed;
        left: 50%;
        top: 10px;
        transform: translateX(-50%);
        z-index: 1002;
        pointer-events: auto;
        display: flex;
        align-items: flex-start;
      }
      .logo img {
        height: 58px !important;
        width: auto !important;
        filter:
          drop-shadow(0 0 1px #000)
          drop-shadow(0 0 1px #000)
          drop-shadow(0 0 2px #000)
          drop-shadow(0 0 2px #000);
      }
      .mob-call-btn { display: none; }
      #navbar .hamburger { display: none; }

      /* ---- Bottom nav spacing ---- */
      .mobile-menu { bottom: 60px; }
      .page-section { padding-bottom: 60px; }

      .two-col { grid-template-columns: 1fr; gap: 2rem; }
      .two-col.reverse { direction: ltr; }
      #contact-page .contact-grid { grid-template-columns: 1fr; }
      .form-row { grid-template-columns: 1fr; }
      .footer-grid { grid-template-columns: 1fr; gap: 2rem; }
      .hero-btns { flex-direction: column; align-items: center; }
      section { padding: 4rem 1.2rem; }
      .content-block { padding: 3.5rem 1.2rem; }
      .why-visual { display: none; }
      .wfp-row { grid-template-columns: 1fr; }
      .page-hero {
        min-height: unset;
        padding: 5.5rem 1.2rem 2rem;
      }
      .page-hero h1 {
        font-size: clamp(2rem, 10vw, 3rem);
        margin-bottom: 0.6rem;
      }
      .page-hero p {
        font-size: 0.92rem;
        line-height: 1.6;
      }
      .breadcrumb { font-size: 0.65rem; margin-bottom: 0.5rem; }
    }

    /* ========== FOCUS LIST ========== */
    .foc-list {
      display: flex;
      flex-direction: column;
      border-top: 1px solid #d0d0d0;
      margin-top: 0;
      position: relative;
    }
    .foc-item {
      display: grid;
      grid-template-columns: 5.5rem 1fr auto;
      align-items: start;
      gap: 0 2.2rem;
      padding: 2.2rem 0 2.2rem 1.6rem;
      border-bottom: 1px solid #d0d0d0;
      position: relative;
      transition: background 0.2s;
    }
    .foc-item::before {
      content: '';
      position: absolute;
      left: 0; top: 0;
      width: 3px; height: 100%;
      background: transparent;
      transition: background 0.2s;
    }
    .foc-item:hover { background: #e8e8e8; }
    .foc-item:hover::before { background: var(--red); }
    .foc-num {
      font-family: var(--font-display);
      font-size: clamp(2.8rem, 4vw, 3.8rem);
      color: var(--red);
      line-height: 1;
      letter-spacing: 0.02em;
      opacity: 0.85;
      transition: opacity 0.2s;
    }
    .foc-item:hover .foc-num { opacity: 1; }
    .foc-body {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      padding-top: 0.15rem;
    }
    .foc-title {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 2.5vw, 2.1rem);
      letter-spacing: 0.05em;
      color: #1a1a1a;
      line-height: 1;
    }
    .foc-desc {
      font-size: 0.85rem;
      color: #555;
      line-height: 1.7;
      max-width: 600px;
    }
    .foc-kicker {
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(0,0,0,0.2);
      white-space: nowrap;
      padding-top: 0.6rem;
      text-align: right;
      transition: color 0.2s;
    }
    .foc-item:hover .foc-kicker { color: rgba(0,0,0,0.35); }
    @media (max-width: 640px) {
      .foc-item { grid-template-columns: 3.8rem 1fr; padding-left: 1rem; }
      .foc-kicker { display: none; }
    }

    /* ========== INDUSTRIES GRID ========== */
    .ind-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: #1e1e1e;
      margin-top: 0;
    }
    .ind-card {
      background: #111;
      padding: 1.8rem 1.8rem 1.8rem 2rem;
      border-left: 3px solid transparent;
      transition: border-color 0.2s, background 0.2s;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .ind-card:hover {
      border-left-color: var(--red);
      background: #141414;
    }
    .ind-card-top {
      display: flex;
      align-items: center;
      gap: 0.9rem;
    }
    .ind-emoji {
      font-size: 1.6rem;
      line-height: 1;
      flex-shrink: 0;
    }
    .ind-card-titles {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }
    .ind-card-title {
      font-size: 0.88rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #ffffff;
      line-height: 1.1;
    }
    .ind-card-vehicles {
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--red);
    }
    .ind-card-desc {
      font-size: 0.82rem;
      color: #aaaaaa;
      line-height: 1.65;
    }
    @media (max-width: 860px) {
      .ind-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 500px) {
      .ind-grid { grid-template-columns: 1fr; }
    }

    /* ========== BUSINESS CASE STAT CARDS ========== */
    .bc-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-top: 1px solid #222;
      border-left: 1px solid #222;
      margin-top: 0;
    }
    .bc-card {
      padding: 2.4rem 2rem 2rem;
      border-right: 1px solid #222;
      border-bottom: 1px solid #222;
      position: relative;
      overflow: hidden;
      transition: background 0.2s;
    }
    .bc-card:hover { background: #111; }
    .bc-card::after {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 3px;
      background: transparent;
      transition: background 0.2s;
    }
    .bc-card:hover::after { background: var(--red); }
    .bc-stat {
      font-family: var(--font-display);
      font-size: clamp(3rem, 4.5vw, 4.5rem);
      color: var(--red);
      line-height: 1;
      letter-spacing: 0.02em;
      margin-bottom: 0.55rem;
    }
    .bc-label {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #ffffff;
      margin-bottom: 0.9rem;
      padding-bottom: 0.9rem;
      border-bottom: 1px solid #222;
    }
    .bc-desc {
      font-size: 0.82rem;
      color: #aaaaaa;
      line-height: 1.65;
    }
    @media (max-width: 700px) {
      .bc-grid { grid-template-columns: repeat(2, 1fr); }
    }

    /* ========== COMMON USES IMAGE CARDS ========== */
    .cu-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 0;
    }
    .cu-card {
      background: #141414;
      border: 1px solid #222;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: border-color 0.25s, transform 0.25s;
    }
    .cu-card:hover {
      border-color: #333;
      transform: translateY(-3px);
    }
    .cu-card-img-wrap {
      position: relative;
      overflow: hidden;
      aspect-ratio: 16 / 10;
      flex-shrink: 0;
    }
    .cu-card-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
      filter: brightness(0.88);
    }
    .cu-card:hover .cu-card-img-wrap img {
      transform: scale(1.04);
      filter: brightness(0.78);
    }
    .cu-card-img-tag {
      position: absolute;
      top: 12px;
      left: 12px;
      background: var(--red);
      color: #fff;
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      padding: 3px 9px;
    }
    .cu-card-body {
      padding: 1.2rem 1.4rem 1.4rem;
      border-top: 2px solid var(--red);
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .cu-card-title {
      font-family: var(--font-display);
      font-size: 1.25rem;
      letter-spacing: 0.06em;
      color: #ffffff;
      margin-bottom: 0.5rem;
      line-height: 1.05;
    }
    .cu-card-desc {
      font-size: 0.82rem;
      color: var(--grey);
      line-height: 1.65;
      flex: 1;
    }
    @media (max-width: 900px) {
      .cu-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 560px) {
      .cu-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
<header id="navbar">
  <a class="logo" href="/">
    <img src="/fly-visuals-logo.png" alt="Fly Visuals Logo" style="height:52px;width:auto;">
  </a>

  <nav>
    <!-- SERVICES dropdown -->
    <div class="nav-item">
      <button class="nav-link">
        Services
        <svg viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5"></path></svg>
      </button>
      <div class="dropdown">
        <!-- WRAPS sub -->
        <div class="dropdown-item">
          <button class="dropdown-link" onclick="showPage('wraps')">
            Wraps
            <svg viewBox="0 0 6 10" fill="none"><path d="M1 1l4 4-4 4" stroke="currentColor" stroke-width="1.5"></path></svg>
          </button>
          <div class="sub-dropdown" style="min-width:220px;">
            <a href="/vehicle-wraps/">Vehicle Wraps</a>
            
            <a href="/fleet-wraps/">Fleet Wraps</a>
            <a href="/boat-wraps/">Boat Wraps</a>
            <a href="/wall-wraps/">Wall Wraps</a>
          </div>
        </div>
        <!-- SIGNS sub -->
        <div class="dropdown-item">
          <button class="dropdown-link" onclick="showPage('signs')">
            Signs
            <svg viewBox="0 0 6 10" fill="none"><path d="M1 1l4 4-4 4" stroke="currentColor" stroke-width="1.5"></path></svg>
          </button>
          <div class="sub-dropdown">
            <a href="/indoor-signs/">Indoor Signs</a>
            <a href="/outdoor-signs/">Outdoor Signs</a>
            <a href="/business-signs/">Business Signs</a>
            <a href="/vinyl-banners/">Vinyl Banners</a>
            <a href="/yard-signs/">Yard Signs</a>
            <a href="/corrugated-signs/">Corrugated Plastic Signs</a>
            <a href="/aluminum-signs/">Custom Aluminum Signs</a>
            <a href="/acrylic-signs/">Custom Acrylic Signs</a>
          </div>
        </div>
        <!-- WINDOW TINTING sub -->
        <div class="dropdown-item">
          <button class="dropdown-link" onclick="showPage('tinting')">
            Window Tinting
            <svg viewBox="0 0 6 10" fill="none"><path d="M1 1l4 4-4 4" stroke="currentColor" stroke-width="1.5"></path></svg>
          </button>
          <div class="sub-dropdown">
            <a href="/auto-tinting/">Auto Window Tinting</a>
            <a href="/residential-tinting/">Residential Window Tinting</a>
            <a href="/commercial-tinting/">Commercial Window Tinting</a>
          </div>
        </div>
        <!-- GRAPHICS sub -->
        <div class="dropdown-item">
          <button class="dropdown-link" onclick="showPage('graphics')">
            Graphics
            <svg viewBox="0 0 6 10" fill="none"><path d="M1 1l4 4-4 4" stroke="currentColor" stroke-width="1.5"></path></svg>
          </button>
          <div class="sub-dropdown">
            <a href="/vehicle-graphics/">Vehicle Graphics</a>
            <a href="/floor-graphics/">Floor Graphics</a>
            <a href="/fleet-graphics/">Fleet Graphics</a>
            <a href="/logo-design/">Logo Design</a>
            <a href="/window-graphics/">Window Graphics</a>
            <a href="/boat-graphics/">Boat Graphics</a>
          </div>
        </div>
      </div>
    </div>

    <div class="nav-item">
      <a class="nav-link" href="/gallery/">Gallery</a>
    </div>
    <div class="nav-item">
      <a class="nav-link" href="/contact/">Contact Us</a>
    </div>
    <a href="tel:7274946162" class="nav-call-btn">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.47 11.47 0 003.58.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.47 11.47 0 00.57 3.58 1 1 0 01-.25 1.01l-2.2 2.2z"></path></svg>
      (727) 494-6162
    </a>
  </nav>

  <a href="tel:7274946162" class="mob-call-btn">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.47 11.47 0 003.58.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.47 11.47 0 00.57 3.58 1 1 0 01-.25 1.01l-2.2 2.2z"></path></svg>
    (727) 494-6162
  </a>

  <button class="hamburger" onclick="toggleMobile()" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</header>
