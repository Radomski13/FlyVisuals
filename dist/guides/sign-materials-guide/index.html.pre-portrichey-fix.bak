          { "@type": "Thing", "position": 2, "name": "Vinyl Banner", "description": "Flexible printed vinyl with reinforced hems and grommets, in 13oz, 18oz, or mesh. Affordable at large sizes, best for events and promotions." },
          { "@type": "Thing", "position": 3, "name": "Aluminum (Flat Panel)", "description": "Solid aluminum sheet, typically .040\" or .063\" thick. Rust-proof, warp-proof, crack-proof — built for years of Florida outdoor exposure." },
          { "@type": "Thing", "position": 4, "name": "ACM (Aluminum Composite)", "description": "Two aluminum sheets bonded to a polyethylene core. Lighter and more rigid than solid aluminum at large sizes — the standard for storefront panels." },
